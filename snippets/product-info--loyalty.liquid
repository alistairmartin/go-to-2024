
<div class="product-info--loyalty">
{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign points_multiplier = 1 -%}

{%- capture product_subscription_content -%}
    <div class="go-to-gang-popup">

    <div class="inner">
        <img class="title" src="{{ 'loyalty--go-to-gang-V2-white.svg' | asset_url }}" alt="Go-To Gang" width="275" height="32">
        <p class="description">A very special loyalty program that rewards your phenomenal taste in skincare. Earn points, unlock perks and special freebies.</p>
        <div class="button-container">
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="button button--primary">JOIN NOW/SIGN IN</a>
        <a href="https://gotoskincare.com/pages/go-to-gang" class="button button--ternary">LEARN MORE</a>
        </div>
    </div>
    
    <img class="background" src="{{ 'loyalty_popup_background.png' | asset_img_url: '450x' }}" alt="Go-To Gang Background" width="450" height="375">
    </div>
{%- endcapture -%}

{%- assign blockId = "loyalty_details" -%}
{%- render 'modal', modalId: blockId, buttonId: blockId, content: product_subscription_content, class: "" -%}

{%- render 'icon' with 'go-to-peach' -%}

{%- if customer -%}
    {%- for tag in customer.tags -%}
        {%- if tag contains "Rivo VIP Tier: Peach Friend" -%}
            {%- assign points_multiplier = 2 -%}
            {%- break -%}
        {%- endif -%}
    {%- endfor -%}
{%- endif -%}

{%- assign loyalty_points = selected_variant.price | times: points_multiplier | divided_by: 100 -%}

<div class="product-info--loyalty-text" data-loyalty-points data-points-multiplier="{{ points_multiplier }}">
    Earn <span data-loyalty-points-value>{{ loyalty_points }}</span> Points!
    {%- if customer and product.selling_plan_groups.size > 0 -%}
        <br><span class="small">Plus 50 Points On Recurring Subscriptions!</span>
    {%- endif -%}
</div>

{%- unless customer -%}
   <button class="product-info--loyalty-link" id="{{ blockId }}">
        learn more
   </button>
{%- endunless -%}
</div>
