{%- comment -%}
  Behaviour (toggle + countdown) and moment-timezone loading live in
  src/js/products.js (class CollapsiblePromoBanner) — shared with the
  blocks/_promo-banner-card.liquid grid card so there is ONE definition of the
  <collapsible-promo-banner> custom element. Defining it inline here used to win
  the customElements.define() race (inline parser scripts run before the deferred
  products.min.js) and shadowed the bundled version with an older class that
  couldn't survive the grid card's slotCards move. products.min.js is loaded
  globally via snippets/files-js.liquid, so this section is covered everywhere.
{%- endcomment -%}

{%- if section.settings.enable_section -%}
  <style>
    #shopify-section-{{ section.id }} {
      --cpb-bg: {{ section.settings.bar_background }};
      --cpb-text: {{ section.settings.text_color }};
    }

    .cpb {
      display: block;
      width: 100%;
      background-color: var(--cpb-bg);
      color: var(--cpb-text);
      font-family: var(--text-font-family);
      text-align: center;
    }

    .cpb__row {
      padding: 8px 20px;
      line-height: 1.3;
    }

    .cpb__row--top {
      padding-bottom: 4px;
    }

    .cpb__row--bottom {
      padding-top: 4px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .cpb__title {
      margin: 0;
      font-weight: 500;
    }

    .cpb__countdown {
      margin: 0;
      font-variant-numeric: tabular-nums;
    }

    .cpb__toggle {
      background: transparent;
      border: 0;
      color: inherit;
      font: inherit;
      cursor: pointer;
      padding: 0;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .cpb__image-wrap {
      max-height: 0;
      overflow: hidden;
      transition: max-height 400ms ease;
    }

    /* Explicit toggle always wins, at any width. */
    .cpb[data-open="true"] .cpb__image-wrap {
      max-height: 1200px;
    }

    .cpb[data-open="false"] .cpb__image-wrap {
      max-height: 0;
    }

    /* Open-by-default (per breakpoint) until the visitor toggles. */
    .cpb[data-default-desktop="true"]:not([data-open]) .cpb__image-wrap {
      max-height: 1200px;
    }

    .cpb__image-inner {
      position: relative;
    }

    .cpb__image-link,
    .cpb__image-block {
      display: block;
      width: 100%;
      line-height: 0;
    }

    .cpb__image {
      display: block;
      width: 100%;
      height: auto;
    }

    .cpb__media--mobile {
      display: none;
    }

    @media (max-width: 740px) {
      .cpb__image-inner--has-mobile .cpb__media--desktop {
        display: none;
      }

      .cpb__image-inner--has-mobile .cpb__media--mobile {
        display: block;
      }
    }

    .cpb__blocks {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 20px;
      text-align: center;
    }

    .cpb__blocks--overlay {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .cpb__blocks--overlay > * {
      pointer-events: auto;
    }

    @media (max-width: 740px) {
      .cpb__row {
        padding-left: 16px;
        padding-right: 16px;
      }

      /* The desktop default does not apply on mobile; the mobile default governs. */
      .cpb[data-default-desktop="true"]:not([data-open]) .cpb__image-wrap {
        max-height: 0;
      }

      .cpb[data-default-mobile="true"]:not([data-open]) .cpb__image-wrap {
        max-height: 1200px;
      }
    }
  </style>

  <collapsible-promo-banner
    class="cpb"
    data-default-desktop="{% if section.settings.open_by_default_desktop %}true{% else %}false{% endif %}"
    data-default-mobile="{% if section.settings.open_by_default_mobile %}true{% else %}false{% endif %}"
    data-end="{{ section.settings.countdown_date | escape }}"
    data-timezone="{{ section.settings.timezone | escape }}"
    data-hide-after="{% if section.settings.hide_after_countdown %}1{% else %}0{% endif %}"
    data-open-text="{{ section.settings.open_text | escape }}"
    data-close-text="{{ section.settings.close_text | escape }}"
  >
    {%- if section.settings.bar_title != blank -%}
      <div class="cpb__row cpb__row--top">
        <p class="cpb__title">{{ section.settings.bar_title | escape }}</p>
      </div>
    {%- endif -%}

    {%- liquid
      assign has_desktop = false
      if section.settings.video != blank or section.settings.background_image != blank
        assign has_desktop = true
      endif

      assign has_mobile = false
      if section.settings.video_mobile != blank or section.settings.background_image_mobile != blank
        assign has_mobile = true
      endif

      assign has_media = false
      if has_desktop or has_mobile
        assign has_media = true
      endif
    -%}

    {%- if has_media or section.blocks.size > 0 -%}
      <div
        id="cpb-image-{{ section.id }}"
        class="cpb__image-wrap"
      >
        <div class="cpb__image-inner{% if has_mobile %} cpb__image-inner--has-mobile{% endif %}">
          {%- if has_media -%}
            {%- capture desktop_media -%}
              {%- if section.settings.video != blank -%}
                {{- section.settings.video | video_tag: image_size: '1100x', autoplay: true, loop: true, muted: true, controls: false, class: 'cpb__image cpb__media cpb__media--desktop' -}}
              {%- elsif section.settings.background_image != blank -%}
                {{-
                  section.settings.background_image
                  | image_url: width: section.settings.background_image.width
                  | image_tag:
                    loading: 'eager',
                    sizes: '100vw',
                    widths: '600,800,1000,1200,1400,1600,1800,2000,2400,2800,3200',
                    class: 'cpb__image cpb__media cpb__media--desktop'
                -}}
              {%- endif -%}
            {%- endcapture -%}

            {%- capture mobile_media -%}
              {%- if section.settings.video_mobile != blank -%}
                {{- section.settings.video_mobile | video_tag: image_size: '800x', autoplay: true, loop: true, muted: true, controls: false, class: 'cpb__image cpb__media cpb__media--mobile' -}}
              {%- elsif section.settings.background_image_mobile != blank -%}
                {{-
                  section.settings.background_image_mobile
                  | image_url: width: section.settings.background_image_mobile.width
                  | image_tag:
                    loading: 'eager',
                    sizes: '100vw',
                    widths: '600,800,1000,1200,1400,1600',
                    class: 'cpb__image cpb__media cpb__media--mobile'
                -}}
              {%- endif -%}
            {%- endcapture -%}

            {%- capture media_markup -%}{{ desktop_media }}{{ mobile_media }}{%- endcapture -%}

            {%- if section.settings.image_link != blank -%}
              <a href="{{ section.settings.image_link }}" class="cpb__image-link">
                {{- media_markup -}}
              </a>
            {%- else -%}
              <div class="cpb__image-block">
                {{- media_markup -}}
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div class="cpb__blocks{% if has_media %} cpb__blocks--overlay{% endif %}">
              {% content_for 'blocks' %}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="cpb__row cpb__row--bottom">
      {%- if section.settings.enable_countdown_timer -%}
        <p class="cpb__countdown" data-countdown>-- Days, -- hours, -- min, -- sec</p>
      {%- endif -%}

      <button
        type="button"
        class="cpb__toggle"
        data-action="toggle"
        aria-expanded="false"
        {% if has_media or section.blocks.size > 0 %}aria-controls="cpb-image-{{ section.id }}"{% endif %}
      >
        {{- section.settings.open_text | escape -}}
      </button>
    </div>
  </collapsible-promo-banner>
{%- endif -%}

{% schema %}
{
  "name": "Collapsible Promo Banner",
  "blocks": [
    { "type": "_promo-container" },
    { "type": "containers" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "header",
      "content": "Top row"
    },
    {
      "type": "text",
      "id": "bar_title",
      "label": "Title",
      "default": "Lucky Dip On Now!"
    },
    {
      "type": "header",
      "content": "Expanding media",
      "info": "Reveals between the top and bottom rows when expanded. If a video is set it takes priority over the image for that breakpoint. Mobile media is optional — desktop media is used on mobile when no mobile media is set."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop image",
      "info": "Put any campaign text directly in the image. 2400 x 800 .jpg recommended."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown on screens 740px and under. Recommend a more square crop, e.g. 1080 x 1080."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video",
      "info": "Optional. Autoplays muted and looped. Takes priority over the desktop image."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video",
      "info": "Optional. Shown on screens 740px and under. Takes priority over the mobile image."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Media link",
      "info": "Optional. Wraps the image or video in a link."
    },
    {
      "type": "header",
      "content": "Default state",
      "info": "Whether the expanding media/content shows on load before the visitor taps the toggle. In the theme editor the banner is always kept open so you can see your changes."
    },
    {
      "type": "checkbox",
      "id": "open_by_default_desktop",
      "label": "Open by default on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "open_by_default_mobile",
      "label": "Open by default on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "text",
      "id": "open_text",
      "label": "Open link text",
      "default": "Open"
    },
    {
      "type": "text",
      "id": "close_text",
      "label": "Close link text",
      "default": "Close"
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "enable_countdown_timer",
      "label": "Enable countdown timer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_after_countdown",
      "label": "Hide section after countdown ends",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown end date & time",
      "default": "May 31, 2027 23:59:00",
      "info": "Format: Sep 21, 2024 15:30:00. Entered in the timezone below."
    },
    {
      "type": "text",
      "id": "timezone",
      "label": "Timezone",
      "default": "Australia/Sydney",
      "info": "E.g. Australia/Sydney, Europe/London, America/Los_Angeles"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Bar background",
      "default": "#f4d4cb"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Bar text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Collapsible Promo Banner"
    }
  ]
}
{% endschema %}
