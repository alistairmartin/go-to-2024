{%- liquid
  assign base_url = shop.url
  assign list_limit = items_limit | default: 20
-%}

{%- if collection and collection.products_count > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ collection.title | strip_html | json }},
    "url": {{ base_url | append: collection.url | json }},
    "numberOfItems": {{ collection.all_products_count | default: collection.products_count | json }},
    "itemListElement": [
      {%- for product in collection.products limit: list_limit -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": {{ base_url | append: product.url | json }},
        "item": {
          "@type": "Product",
          "name": {{ product.title | strip_html | json }},
          "url": {{ base_url | append: product.url | json }}{%- if product.featured_image -%},
          "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}
