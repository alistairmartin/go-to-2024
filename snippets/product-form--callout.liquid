<div class="product-form-callout">
  {%- if block.settings.link != blank -%}
    <a href="{{ block.settings.link }}">
  {%- endif -%}
  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'hide-mobile' }}
  {%- if block.settings.image_mobile != blank -%}
    {{ block.settings.image_mobile | image_url: width: 700 | image_tag: loading: 'lazy', class: 'hide-desktop' }}
  {%- endif -%}
  {%- if block.settings.link != blank -%}
    </a>
  {%- endif -%}
</div>