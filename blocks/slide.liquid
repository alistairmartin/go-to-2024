{%- assign classes = "" -%}
{%- assign video_ratio_desktop_value = block.settings.video_aspect_ratio_desktop | default: 1 -%}
{%- assign video_ratio_mobile_value = block.settings.video_aspect_ratio_mobile | default: 1 -%}

{%- if video_ratio_desktop_value == "auto" -%}
    {%- if block.settings.video_desktop != blank -%}
      {%- assign video_ratio_desktop_value = 1.0 | divided_by: block.settings.video_desktop.aspect_ratio -%}
    {%- elsif block.settings.video_mobile != blank -%}
      {%- assign video_ratio_desktop_value = 1.0 | divided_by: block.settings.video_mobile.aspect_ratio -%}
    {%- endif -%}
  {%- endif -%}

  {%- if video_ratio_mobile_value == "auto" -%}
    {%- if block.settings.video_mobile != blank -%}
      {%- assign video_ratio_mobile_value = 1.0 | divided_by: block.settings.video_mobile.aspect_ratio -%}
    {%- elsif block.settings.video_desktop != blank -%}
      {%- assign video_ratio_mobile_value = 1.0 | divided_by: block.settings.video_desktop.aspect_ratio -%}
    {%- endif -%}
  {%- endif -%}

{%- if video_ratio_desktop_value == "auto" -%}
  {%- assign video_ratio_desktop_value = 1 -%}
{%- endif -%}
{%- if video_ratio_mobile_value == "auto" -%}
  {%- assign video_ratio_mobile_value = 1 -%}
{%- endif -%}

{%- comment -%} Custom poster images: injected as the first poster attribute so they win over the video_tag default {%- endcomment -%}
{%- assign poster_desktop_attr = "<video" -%}
{%- assign poster_mobile_attr = "<video" -%}
{%- if block.settings.video_poster_desktop != blank -%}
  {%- capture poster_desktop_attr -%}<video poster="{{ block.settings.video_poster_desktop | image_url: width: 2400 }}"{%- endcapture -%}
  {%- assign poster_mobile_attr = poster_desktop_attr -%}
{%- endif -%}
{%- if block.settings.video_poster_mobile != blank -%}
  {%- capture poster_mobile_attr -%}<video poster="{{ block.settings.video_poster_mobile | image_url: width: 1200 }}"{%- endcapture -%}
{%- endif -%}

{%- comment -%} Poster overlay: covers the paused video (hides iOS native play glyph), fades out on play {%- endcomment -%}
{%- assign poster_overlay_markup = "" -%}
{%- if block.settings.background_media == "video" -%}
  {%- assign ov_desktop_video = block.settings.video_desktop -%}
  {%- assign ov_mobile_video = block.settings.video_mobile -%}
  {%- if ov_desktop_video == blank and ov_mobile_video != blank -%}
    {%- assign ov_desktop_video = ov_mobile_video -%}
    {%- assign ov_mobile_video = blank -%}
  {%- endif -%}
  {%- assign ov_desktop_img = block.settings.video_poster_desktop -%}
  {%- if ov_desktop_img == blank and ov_desktop_video != blank -%}
    {%- assign ov_desktop_img = ov_desktop_video.preview_image -%}
  {%- endif -%}
  {%- assign ov_mobile_img = block.settings.video_poster_mobile -%}
  {%- if ov_mobile_img == blank and ov_mobile_video != blank -%}
    {%- assign ov_mobile_img = ov_mobile_video.preview_image -%}
  {%- endif -%}
  {%- if ov_mobile_img == blank -%}
    {%- assign ov_mobile_img = ov_desktop_img -%}
  {%- endif -%}
  {%- capture poster_overlay_markup -%}
    <div class="slide-video-poster" id="video-poster-{{ block.id }}" aria-hidden="true">
      {%- if ov_desktop_img != blank -%}
        {{ ov_desktop_img | image_url: width: 2400 | image_tag: loading: "eager", sizes: "100vw", widths: "800,1200,1600,2000,2400", class: "hide-mobile", alt: "" }}
      {%- endif -%}
      {%- if ov_mobile_img != blank -%}
        {{ ov_mobile_img | image_url: width: 1200 | image_tag: loading: "eager", sizes: "100vw", widths: "600,800,1000,1200", class: "hide-desktop", alt: "" }}
      {%- endif -%}
    </div>
  {%- endcapture -%}
{%- endif -%}

{%- capture styles -%}
