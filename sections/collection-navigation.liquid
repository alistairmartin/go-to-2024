<style>
  #shopify-section-{{ section.id }} {
    --section-background: {{ section.settings.background }};
    --border-color-setting: {{ section.settings.border_color }};
  }

  #shopify-section-{{ section.id }} .link-bar {
    text-align: left;
  }

  #shopify-section-{{ section.id }} .link-bar__linklist {
    gap: 15px;
  }

  #shopify-section-{{ section.id }} .link-bar__title,
  #shopify-section-{{ section.id }} .link-bar__linklist a {
    font-size: 14px;
    line-height: 18px;
  }

  #shopify-section-{{ section.id }} .link-bar__linklist a {
    display: inline-block;
    padding: 6px 10px;
    font-weight: 500;
    color: #282828;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .link-bar__linklist a:hover {
    text-decoration: underline;
    text-decoration-color: #181818;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  #shopify-section-{{ section.id }} .link-bar__link-item:first-child a {
    padding-left: 0;
  }

  #shopify-section-{{ section.id }} .link-bar__link-item--selected a {
    text-decoration: underline;
    text-decoration-color: #181818;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
</style>

{% content_for 'blocks' %}

{% schema %}
  {
    "name": "Collection Navigation",
    "class": "shopify-section--custom-navigation",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_container",
        "label": "Enable Container",
        "default": true
      },
      {
        "type": "color",
        "id": "background",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border Colour",
        "default": "#dddddd"
      }
    ],
    "blocks": [
      { "type": "_collection-navigation-select" }
    ],
    "presets": [
      {
        "name": "Collection Navigation"
      }
    ]
  }
{% endschema %}
