{%- if collection.handle == "tween-and-teen-skin" -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What skincare products should tweens use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tweens only need a very simple routine. A gentle cleanser and lightweight moisturiser are enough to keep skin clean, comfortable, and supported without overwhelming young, developing skin."
      }
    },
    {
      "@type": "Question",
      "name": "At what age should a child start using skincare products?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Many tweens can begin basic skincare around age 8, especially if they’re wearing sunscreen or makeup. Parent guidance and supervision are important to ensure products are age-appropriate and used correctly."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know if a product is suitable for sensitive skin?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Always introduce new products slowly and watch for signs like redness, stinging or irritation. If skin reacts, stop using the product and simplify the routine. Gentle formulas designed for sensitive skin are best."
      }
    },
    {
      "@type": "Question",
      "name": "Is sunscreen necessary every day?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Sunscreen is important at any age to help protect skin from sun damage. Daily SPF is one of the most important steps in any tween or teen skincare routine."
      }
    },
    {
      "@type": "Question",
      "name": "How can teenage acne be managed safely?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Teenage acne should be approached gently. Stick to minimal products that help cleanse and balance oil without harsh ingredients. Avoid aggressive treatments and over-exfoliating, as these can irritate skin and make breakouts worse."
      }
    }
  ]
}
</script>
{%- endif -%}
