{%- comment -%}
  Collection Banner V2 — image/video block.
  Holds an image OR video background, with an optional positioned text + button overlay.
  The image (when present) sizes the banner in normal flow; video is layered over it.
  Video-only banners are sized by the video itself. Mirrors blocks/_content-card.liquid.
{%- endcomment -%}

{%- assign image_desktop = block.settings.image_desktop -%}
{%- assign image_mobile = block.settings.image_mobile -%}
{%- if image_mobile == blank -%}{%- assign image_mobile = image_desktop -%}{%- endif -%}
{%- if image_desktop == blank -%}{%- assign image_desktop = image_mobile -%}{%- endif -%}

{%- assign has_image = false -%}
{%- if image_desktop != blank or image_mobile != blank -%}{%- assign has_image = true -%}{%- endif -%}

{%- assign video_desktop = block.settings.video_desktop -%}
{%- assign video_mobile = block.settings.video_mobile -%}
{%- assign has_desktop_video = false -%}
{%- if video_desktop != blank -%}{%- assign has_desktop_video = true -%}{%- endif -%}
{%- assign has_mobile_video = false -%}
{%- if video_mobile != blank -%}{%- assign has_mobile_video = true -%}{%- endif -%}
{%- assign has_video = false -%}
{%- if has_desktop_video or has_mobile_video -%}{%- assign has_video = true -%}{%- endif -%}

{%- if has_image or has_video -%}

  {%- capture styles -%}
    <style>
      #block-{{ block.id }} {
        position: relative;
        display: block;

        --cb-justify-desktop: {{ block.settings.content_justify_desktop }};
        --cb-align-desktop: {{ block.settings.content_align_desktop }};
        --cb-justify-mobile: {{ block.settings.content_justify_mobile }};
        --cb-align-mobile: {{ block.settings.content_align_mobile }};

        --cb-pad-v-desktop: {{ block.settings.padding_vertical_desktop }}px;
        --cb-pad-h-desktop: {{ block.settings.padding_horizontal_desktop }}px;
        --cb-pad-v-mobile: {{ block.settings.padding_vertical_mobile }}px;
        --cb-pad-h-mobile: {{ block.settings.padding_horizontal_mobile }}px;

        --cb-gap-desktop: {{ block.settings.grid_gap_vertical_desktop }}vw;
        --cb-gap-mobile: {{ block.settings.grid_gap_vertical_mobile }}vw;
      }

      #block-{{ block.id }} .collection-banner-v2__image,
      #block-{{ block.id }} .collection-banner-v2__video--inflow {
        display: block;
        width: 100%;
        height: auto;
      }

      #block-{{ block.id }} .collection-banner-v2__media {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      #block-{{ block.id }} .collection-banner-v2__media .collection-banner-v2__video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      #block-{{ block.id }} .collection-banner-v2__video--desktop { display: none; }
      #block-{{ block.id }} .collection-banner-v2__video--mobile { display: block; }
      @media (min-width: 741px) {
        #block-{{ block.id }} .collection-banner-v2__video--desktop { display: block; }
        #block-{{ block.id }} .collection-banner-v2__video--mobile { display: none; }
      }

      #block-{{ block.id }} .collection-banner-v2__link {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: block;
      }

      #block-{{ block.id }} .collection-banner-v2__content {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        /* Column flex: justify-content = vertical, align-items = horizontal. */
        justify-content: var(--cb-align-mobile, center);
        align-items: var(--cb-justify-mobile, center);
        gap: var(--cb-gap-mobile, 0);
        padding: var(--cb-pad-v-mobile, 16px) var(--cb-pad-h-mobile, 16px);
        pointer-events: none; /* let clicks fall through to the banner link... */
      }

      #block-{{ block.id }} .collection-banner-v2__content > * {
        pointer-events: auto; /* ...except on the text/button blocks themselves. */
      }

      @media (min-width: 741px) {
        #block-{{ block.id }} .collection-banner-v2__content {
          justify-content: var(--cb-align-desktop, center);
          align-items: var(--cb-justify-desktop, center);
          gap: var(--cb-gap-desktop, 0);
          padding: var(--cb-pad-v-desktop, 30px) var(--cb-pad-h-desktop, 30px);
        }
      }
    </style>
  {%- endcapture -%}
  {{- styles | strip_newlines | strip -}}

  <div class="collection-banner-v2__image-wrap" id="block-{{ block.id }}" {{ block.shopify_attributes }}>

    {%- if has_image -%}
      {%- render 'responsive-image',
        src_desktop: image_desktop,
        src_mobile: image_mobile,
        alt: block.settings.alt,
        class: 'collection-banner-v2__image'
      -%}

      {%- if has_video -%}
        <div class="collection-banner-v2__media">
          {%- if has_desktop_video -%}
            {%- assign dv_class = 'collection-banner-v2__video' -%}
            {%- if has_mobile_video -%}{%- assign dv_class = 'collection-banner-v2__video collection-banner-v2__video--desktop' -%}{%- endif -%}
            {{ video_desktop | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: dv_class }}
          {%- endif -%}
          {%- if has_mobile_video -%}
            {%- assign mv_class = 'collection-banner-v2__video' -%}
            {%- if has_desktop_video -%}{%- assign mv_class = 'collection-banner-v2__video collection-banner-v2__video--mobile' -%}{%- endif -%}
            {{ video_mobile | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: mv_class }}
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- elsif has_video -%}
      {%- comment -%} No image — the video itself sizes the banner. {%- endcomment -%}
      {%- if has_desktop_video -%}
        {%- assign dv_class = 'collection-banner-v2__video collection-banner-v2__video--inflow' -%}
        {%- if has_mobile_video -%}{%- assign dv_class = 'collection-banner-v2__video collection-banner-v2__video--inflow collection-banner-v2__video--desktop' -%}{%- endif -%}
        {{ video_desktop | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: dv_class }}
      {%- endif -%}
      {%- if has_mobile_video -%}
        {%- assign mv_class = 'collection-banner-v2__video collection-banner-v2__video--inflow' -%}
        {%- if has_desktop_video -%}{%- assign mv_class = 'collection-banner-v2__video collection-banner-v2__video--inflow collection-banner-v2__video--mobile' -%}{%- endif -%}
        {{ video_mobile | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: mv_class }}
      {%- endif -%}
    {%- endif -%}

    {%- if block.settings.link != blank -%}
      <a class="collection-banner-v2__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.alt | default: 'View collection' | escape }}"></a>
    {%- endif -%}

    <div class="collection-banner-v2__content">
      {% content_for 'blocks' %}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Image",
  "blocks": [
    { "type": "text" },
    { "type": "button" },
    { "type": "@theme" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image (desktop)",
      "info": "Sizes the banner. Also used as the video poster."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Video (desktop)",
      "info": "Optional. Shopify-hosted video layered over the image. Plays muted & looped."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video (mobile)",
      "info": "Optional. Falls back to the desktop video if empty."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the whole banner clickable (behind the text/button blocks)."
    },
    {
      "type": "header",
      "content": "--- 🖥️ DESKTOP SETTINGS 🖥️ ---",
      "info": "Position the text & button overlay over the image/video."
    },
    {
      "type": "select",
      "id": "content_justify_desktop",
      "label": "Content position (horizontal)",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "content_align_desktop",
      "label": "Content position (vertical)",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ]
    },
    {
      "type": "range",
      "id": "padding_vertical_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 30,
      "label": "↕️ Padding Top/Bottom"
    },
    {
      "type": "range",
      "id": "padding_horizontal_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 30,
      "label": "↔️ Padding Left/Right"
    },
    {
      "type": "range",
      "id": "grid_gap_vertical_desktop",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "unit": "vw",
      "default": 0.5,
      "label": "⏸️ Item Spacing"
    },
    {
      "type": "header",
      "content": "--- 📱 MOBILE SETTINGS 📱 ---"
    },
    {
      "type": "select",
      "id": "content_justify_mobile",
      "label": "Content position (horizontal)",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Content position (vertical)",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ]
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "↕️ Padding Top/Bottom"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "↔️ Padding Left/Right"
    },
    {
      "type": "range",
      "id": "grid_gap_vertical_mobile",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "unit": "vw",
      "default": 1,
      "label": "⏸️ Item Spacing"
    }
  ],
  "presets": [
    {
      "name": "Image"
    }
  ]
}
{% endschema %}
