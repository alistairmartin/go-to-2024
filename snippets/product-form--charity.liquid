{%- assign charity_article = block.settings.article -%}
{%- assign charity_text = block.settings.text -%}

{%- if charity_text != blank or charity_article != blank -%}
  {%- assign blockId = 'product-charity-' | append: block.id -%}

  {%- if charity_article != blank -%}
    {%- capture charity_popover_content -%}
      <div class="product-charity-popup">
        {%- if charity_article.image != blank -%}
          <div class="product-charity-popup__image">
            {{ charity_article.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 740px) 500px, 100vw', widths: '400, 700, 1000, 1200', alt: charity_article.image.alt | default: charity_article.title }}
          </div>
        {%- endif -%}

        <h2 class="product-charity-popup__title heading h5">{{ charity_article.title }}</h2>

        {%- if charity_article.excerpt != blank -%}
          <div class="product-charity-popup__excerpt article__excerpt text--large">
            {{- charity_article.excerpt -}}
          </div>
        {%- endif -%}

        <div class="product-charity-popup__body article__content">
          <div class="rte">
            {{ charity_article.content }}
          </div>
        </div>
      </div>
    {%- endcapture -%}
  {%- endif -%}

  <div class="product-form--charity" {{ block.shopify_attributes }}>
