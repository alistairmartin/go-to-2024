

{%- unless button -%}
  {%- assign button = "primary" -%}
{%- endunless -%}

{%- unless hide_icon == true -%}
  {%- assign hide_icon = false -%}
{%- endunless -%}


<div class="popover-buttons">
  <button type="button" is="toggle-button" class="link link--{{ button }} hidden-phone" aria-controls="{{ popoverId }}-drawer" aria-expanded="false">{{ popoverButton }} {% unless hide_icon %}{%- render 'icon' with "plus" -%}{% endunless %}</button>
</div>


<drawer-content id="{{ popoverId }}-drawer" class="drawer drawer--large hidden-phone">
    <span class="drawer__overlay"></span>

    <header class="drawer__header">
      <p class="drawer__title heading h5">{{ popoverTitle }}</p>

      <button type="button" class="drawer__close-button tap-area" data-action="close" title="{{ 'general.accessibility.close' | t | escape }}">
        {%- render 'icon' with 'close' -%}
      </button>
    </header>

    <div class="drawer__content drawer__content--padded-start">
      <div class="rte">
        {{ popoverContent }}
      </div>
    </div>
  </drawer-content>

