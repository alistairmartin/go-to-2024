<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.background == 'rgba(0,0,0,0)' -%}
      {%- assign section_background = settings.background -%}
    {%- else -%}
      {%- assign section_background = section.settings.background -%}
    {%- endif -%}

    {%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
      {%- assign heading_color = settings.heading_color -%}
      {%- assign text_color = settings.text_color -%}
    {%- else -%}
      {%- assign heading_color = section.settings.text_color -%}
      {%- assign text_color = section.settings.text_color -%}
    {%- endif -%}

    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --prev-next-button-background: var(--text-color);
    --prev-next-button-color: var(--section-background);

    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};

    {%- if section.settings.enable_custom_progress_bar_colour -%}
      --progress-bar: {{ section.settings.progress_bar_colour.red }}, {{ section.settings.progress_bar_colour.green }}, {{ section.settings.progress_bar_colour.blue }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }}  video {
    height: var(--gallery-image-height);
    width: auto;
  }

  {%- if section.settings.cards_per_view_desktop > 0 -%}
  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} scrollable-content .container,
    #shopify-section-{{ section.id }} scrollable-content .no-container {
      padding-left: 0;
      padding-right: 0;
      margin-left: 0;
      max-width: none;
    }
    #shopify-section-{{ section.id }} .gallery__list {
      padding-left: {{ section.settings.cards_per_view_padding_desktop }}px;
      padding-right: {{ section.settings.cards_per_view_padding_desktop }}px;
    }
    #shopify-section-{{ section.id }} .gallery__item {
      width: calc((100vw - {{ section.settings.cards_per_view_padding_desktop | times: 2 }}px - ({{ section.settings.cards_per_view_desktop }} - 1) * {{ section.settings.cards_per_view_gap_desktop }}px) / {{ section.settings.cards_per_view_desktop }});
    }
    #shopify-section-{{ section.id }} .gallery__item:not(:first-child) {
      margin-inline-start: {{ section.settings.cards_per_view_gap_desktop }}px;
    }
    #shopify-section-{{ section.id }} .gallery__list::after {
      flex: 0 0 0;
    }
    #shopify-section-{{ section.id }} video {
      width: 100%;
      height: auto;
    }
    #shopify-section-{{ section.id }} .gallery__image {
      width: 100%;
      height: auto;
    }
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .section__header .heading:not(.heading--small) {
    text-align: {{ section.settings.title_text_align_desktop }};
    font-size: {{ section.settings.title_font_size_desktop }}px;
    font-weight: {{ section.settings.title_font_weight_desktop }};
    font-style: {{ section.settings.title_font_style_desktop }};
    margin-bottom: {{ section.settings.title_margin_bottom_desktop }}px;
  }

  #shopify-section-{{ section.id }} .section__header .heading--small {
    text-align: {{ section.settings.subheading_text_align_desktop }};
    font-size: {{ section.settings.subheading_font_size_desktop }}px;
    font-weight: {{ section.settings.subheading_font_weight_desktop }};
    font-style: {{ section.settings.subheading_font_style_desktop }};
    margin-bottom: {{ section.settings.subheading_margin_bottom_desktop }}px;
  }

  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} .section__header .heading:not(.heading--small) {
      text-align: {{ section.settings.title_text_align_mobile }};
      font-size: {{ section.settings.title_font_size_mobile }}px;
      font-weight: {{ section.settings.title_font_weight_mobile }};
      font-style: {{ section.settings.title_font_style_mobile }};
      margin-bottom: {{ section.settings.title_margin_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .section__header .heading--small {
      text-align: {{ section.settings.subheading_text_align_mobile }};
      font-size: {{ section.settings.subheading_font_size_mobile }}px;
      font-weight: {{ section.settings.subheading_font_weight_mobile }};
      font-style: {{ section.settings.subheading_font_style_mobile }};
      margin-bottom: {{ section.settings.subheading_margin_bottom_mobile }}px;
    }
  }

  {%- for block in section.blocks -%}

    {%- if block.settings.enable_media_height -%}
        #block-{{ block.id }} .gallery__image, #block-{{ block.id }} video {
          height: {{ block.settings.media_height }}vw;
        }
    {%- endif -%}

    #block-{{ block.id }} .gallery__item-title {
      text-align: {{ block.settings.title_text_align_desktop }};
      font-size: {{ block.settings.title_font_size_desktop }}px;
      font-weight: {{ block.settings.title_font_weight_desktop }};
      font-style: {{ block.settings.title_font_style_desktop }};
      margin-bottom: {{ block.settings.title_margin_bottom_desktop }}px;
      {%- if brand == "go-to" -%}{%- if block.settings.title_font_family_desktop == "primary" -%}font-family:"Benton";{%- elsif block.settings.title_font_family_desktop == "secondary" -%}font-family:"Marcel";{%- endif -%}{%- elsif brand == "bro-to" -%}{%- if block.settings.title_font_family_desktop == "primary" -%}font-family:"MillerDisplay";{%- elsif block.settings.title_font_family_desktop == "secondary" -%}font-family:"FFMarkWebPro";{%- endif -%}{%- elsif brand == "gro-to" -%}{%- if block.settings.title_font_family_desktop == "primary" -%}font-family:"ProximaNova";{%- elsif block.settings.title_font_family_desktop == "secondary" -%}font-family:"SofiaProSoft";{%- endif -%}{%- endif -%}
    }

    #block-{{ block.id }} .gallery__caption {
      text-align: {{ block.settings.caption_text_align_desktop }};
      font-size: {{ block.settings.caption_font_size_desktop }}px;
      font-weight: {{ block.settings.caption_font_weight_desktop }};
      font-style: {{ block.settings.caption_font_style_desktop }};
      margin-bottom: {{ block.settings.caption_margin_bottom_desktop }}px;
      {%- if brand == "go-to" -%}{%- if block.settings.caption_font_family_desktop == "primary" -%}font-family:"Benton";{%- elsif block.settings.caption_font_family_desktop == "secondary" -%}font-family:"Marcel";{%- endif -%}{%- elsif brand == "bro-to" -%}{%- if block.settings.caption_font_family_desktop == "primary" -%}font-family:"MillerDisplay";{%- elsif block.settings.caption_font_family_desktop == "secondary" -%}font-family:"FFMarkWebPro";{%- endif -%}{%- elsif brand == "gro-to" -%}{%- if block.settings.caption_font_family_desktop == "primary" -%}font-family:"ProximaNova";{%- elsif block.settings.caption_font_family_desktop == "secondary" -%}font-family:"SofiaProSoft";{%- endif -%}{%- endif -%}
    }

    @media screen and (max-width: 740px) {
      #block-{{ block.id }} .gallery__item-title {
        text-align: {{ block.settings.title_text_align_mobile }};
        font-size: {{ block.settings.title_font_size_mobile }}px;
        font-weight: {{ block.settings.title_font_weight_mobile }};
        font-style: {{ block.settings.title_font_style_mobile }};
        margin-bottom: {{ block.settings.title_margin_bottom_mobile }}px;
        {%- if brand == "go-to" -%}{%- if block.settings.title_font_family_mobile == "primary" -%}font-family:"Benton";{%- elsif block.settings.title_font_family_mobile == "secondary" -%}font-family:"Marcel";{%- endif -%}{%- elsif brand == "bro-to" -%}{%- if block.settings.title_font_family_mobile == "primary" -%}font-family:"MillerDisplay";{%- elsif block.settings.title_font_family_mobile == "secondary" -%}font-family:"FFMarkWebPro";{%- endif -%}{%- elsif brand == "gro-to" -%}{%- if block.settings.title_font_family_mobile == "primary" -%}font-family:"ProximaNova";{%- elsif block.settings.title_font_family_mobile == "secondary" -%}font-family:"SofiaProSoft";{%- endif -%}{%- endif -%}
      }
      #block-{{ block.id }} .gallery__caption {
        text-align: {{ block.settings.caption_text_align_mobile }};
        font-size: {{ block.settings.caption_font_size_mobile }}px;
        font-weight: {{ block.settings.caption_font_weight_mobile }};
        font-style: {{ block.settings.caption_font_style_mobile }};
        margin-bottom: {{ block.settings.caption_margin_bottom_mobile }}px;
        {%- if brand == "go-to" -%}{%- if block.settings.caption_font_family_mobile == "primary" -%}font-family:"Benton";{%- elsif block.settings.caption_font_family_mobile == "secondary" -%}font-family:"Marcel";{%- endif -%}{%- elsif brand == "bro-to" -%}{%- if block.settings.caption_font_family_mobile == "primary" -%}font-family:"MillerDisplay";{%- elsif block.settings.caption_font_family_mobile == "secondary" -%}font-family:"FFMarkWebPro";{%- endif -%}{%- elsif brand == "gro-to" -%}{%- if block.settings.caption_font_family_mobile == "primary" -%}font-family:"ProximaNova";{%- elsif block.settings.caption_font_family_mobile == "secondary" -%}font-family:"SofiaProSoft";{%- endif -%}{%- endif -%}
      }
    }

  {%- endfor -%}
  
</style>

<section class="section {% unless blends_with_background %}section--flush{% endunless %} {% if section.settings.arrow_bottom_right %}arrows-bottom-right{% endif %} {% if section.settings.hide_desktop %}hide-desktop{% endif %} {% if section.settings.hide_mobile %}hide-mobile{% endif %}">
  <div class="section__color-wrapper {% unless blends_with_background %}vertical-breather{% endunless %}">

    <div class="container container-header">
      {%- if section.settings.subheading != blank or section.settings.title != blank -%}
        <header class="section__header container text-container text-{{ section.settings.header_text_alignment }}">
      
          {%- if section.settings.title != blank -%}
            <h3 class="heading {{ section.settings.heading_html }} heading--{{ section.settings.font_family_title }}">{{ section.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <h2 class="heading heading--small">{{ section.settings.subheading | escape }}</h2>
          {%- endif -%}
  
        </header>
      {%- endif -%}
    </div>


    {%- comment -%}
    If we have more than 3 blocks we assume that by default the content may be scrollable. This may not be the case and
    the JavaScript will fired up to remove it in case it is needed, but if it is indeed scrollable this will avoid
    a reflow of the browser rendering engine. From our tests 3 is a sane default.
    {%- endcomment -%}
    <gallery-list class="gallery">
      <scrollable-content {% unless section.settings.show_arrows %}draggable{% endunless %} class="gallery__list-wrapper {% if section.blocks.size >= 3 %}is-scrollable{% endif %} hide-scrollbar">
        <div class="{% if section.settings.enable_container %}container{% else %}no-container{% endif %}">
          <div class="gallery__list">
            {%- for block in section.blocks -%}
              <gallery-item class="gallery__item" {{ block.shopify_attributes }} id="block-{{ block.id }}">
                <figure class="gallery__figure">


                  {%- if block.settings.video != blank -%}


                    {%- if block.settings.video_poster != blank or block.settings.enable_autoplay -%}
                      {%- assign posterImage = block.settings.video_poster | image_url: width: 600 -%}
                    {% else %}
                      {%- assign posterImage = "none" -%}
                    {%- endif -%}

                      {%- assign autoPlay = false -%}
                      {%- if block.settings.enable_autoplay -%}
                          {%- assign autoPlay = true -%}
                      {%- endif -%}

                        {{- block.settings.video | video_tag: controls: true, autoplay: block.settings.enable_autoplay, muted: block.settings.enable_mute, playsinline: true, loop: block.settings.enable_loop_video, poster: posterImage -}}

                  {%- elsif block.settings.image -%}
                    {%- assign mobile_size = 370 | times: block.settings.image.aspect_ratio | ceil -%}
                    {%- assign tablet_size = 520 | times: block.settings.image.aspect_ratio | ceil -%}
                    {%- assign desktop_size = 600 | times: block.settings.image.aspect_ratio | ceil -%}
                    {%- capture sizes_attribute -%}(max-width: 740px) {{ mobile_size }}px, (max-width: 999px) {{ tablet_size }}px, {{ desktop_size }}px{%- endcapture -%}

                    {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600,1700,1800,1900,2000', class: 'gallery__image' }}
                  {%- else -%}
                    {{- 'image' | placeholder_svg_tag: 'gallery__image gallery__image placeholder-background' -}}
                  {%- endif -%}

                  {%- if block.settings.title != blank -%}
                    <p class="gallery__item-title">{{ block.settings.title | escape }}</p>
                  {%- endif -%}

                  {%- if block.settings.caption != blank -%}
                    <figcaption class="gallery__caption rte">
                      {{- block.settings.caption -}}
                    </figcaption>
                  {%- endif -%}
                </figure>
              </gallery-item>
            {%- endfor -%}
          </div>
        </div>
      </scrollable-content>

      {%- if section.blocks.size > 1 and section.settings.show_arrows -%}
        <prev-next-buttons class="gallery__prev-next-buttons prev-next-buttons">
          <button class="gallery__arrow prev-next-button prev-next-button--prev">
            <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
            {%- render 'icon' with 'nav-arrow-left', direction_aware: true -%}
          </button>

          <button class="gallery__arrow prev-next-button prev-next-button--next">
            <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
            {%- render 'icon' with 'nav-arrow-right', direction_aware: true -%}
          </button>
        </prev-next-buttons>
      {% endif %}

      <div class="gallery__progress-bar-wrapper container">
        <span class="gallery__progress-bar progress-bar {% if section.settings.enable_custom_progress_bar_colour %}progress-bar-custom{% endif %}" style="--divider: {{ section.blocks.size }}"></span>
      </div>
    </gallery-list>
  </div>
</section>

