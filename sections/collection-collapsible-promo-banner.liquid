<style>
  #shopify-section-{{ section.id }} .cpb {
    display: block;
    width: 100%;
    background-color: var(--cpb-bg);
    color: var(--cpb-text);
    font-family: var(--text-font-family);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cpb__row {
    padding: 8px 20px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .cpb__row--top {
    padding-bottom: 4px;
  }

  #shopify-section-{{ section.id }} .cpb__row--bottom {
    padding-top: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .cpb__title {
    margin: 0;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .cpb__countdown {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  #shopify-section-{{ section.id }} .cpb__toggle {
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .cpb__image-wrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 400ms ease;
  }

  #shopify-section-{{ section.id }} .cpb[data-open="true"] .cpb__image-wrap {
    max-height: 1200px;
  }

  #shopify-section-{{ section.id }} .cpb__image-inner {
    position: relative;
  }

  #shopify-section-{{ section.id }} .cpb__image-link,
  #shopify-section-{{ section.id }} .cpb__image-block {
    display: block;
    width: 100%;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .cpb__image {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .cpb__blocks {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cpb__blocks--overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .cpb__blocks--overlay > * {
    pointer-events: auto;
  }

  @media (max-width: 740px) {
    #shopify-section-{{ section.id }} .cpb__row {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>

{% content_for 'blocks' %}

{% schema %}
{
  "name": "Collection Promo Banner",
  "class": "shopify-section--collection-promo-banner",
  "blocks": [
    { "type": "_collection-promo-select" }
  ],
  "presets": [
    {
      "name": "Collection Promo Banner",
      "blocks": [
        {
          "type": "_collection-promo-select",
          "blocks": [
            { "type": "_collection-promo-banner" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
