   {%- capture styles -%}
      <style>
          #shopify-block-{{ block.id }} {
            display: flex;
            justify-content: var(--flex-justify-content-mobile);

            --margin-top-desktop: {{ block.settings.margin_top_desktop }}px;
            --margin-bottom-desktop: {{ block.settings.margin_bottom_desktop }}px;
  
            --margin-top-mobile: {{ block.settings.margin_top_mobile }}px;
            --margin-bottom-mobile: {{ block.settings.margin_bottom_mobile }}px;
  
            --flex-justify-content-mobile: {{ block.settings.flex_justify_content_mobile }};
            --flex-justify-content-desktop: {{ block.settings.flex_justify_content_desktop }};

            --button-width-mobile: {% if block.settings.button_width_mobile == 0 %}auto{% else %}{{ block.settings.button_width_mobile }}vw{% endif %};
            --button-width-desktop: {% if block.settings.button_width_desktop == 0 %}auto{% else %}{{ block.settings.button_width_desktop }}vw{% endif %};
  

              --button-color-text-mobile: {{ block.settings.button_color_mobile }};
              --button-color-text-desktop: {{ block.settings.button_color_desktop }};

          }

          @media (min-width: 740px) {
            #shopify-block-{{ block.id }} {
              justify-content: var(--flex-justify-content-desktop);
            }
          }
      </style>
      {%- endcapture -%}
      {{- styles | strip_newlines | remove:" " | strip -}}
  
      {%- assign classes = "" -%}
  
      {%- unless block.settings.flex_justify_content_mobile == "unset" -%}
          {%- assign classes = classes | append: " flex-content--mobile" -%}
      {%- endunless -%}
  
      {%- unless block.settings.flex_justify_content_desktop == "unset" -%}
          {%- assign classes = classes | append: " flex-content--desktop" -%}
      {%- endunless -%}
  
      {%- comment -%} Resolve per-breakpoint styles. Mobile falls back to the desktop style unless overridden. {%- endcomment -%}
      {%- assign desktop_style = block.settings.button_style -%}
      {%- assign mobile_style = block.settings.button_style_mobile -%}
      {%- if mobile_style == blank or mobile_style == "inherit" -%}
        {%- assign mobile_style = desktop_style -%}
      {%- endif -%}

      {%- comment -%} Render once when styles match, otherwise render a desktop + mobile element toggled by hide classes. {%- endcomment -%}
      {%- if mobile_style == desktop_style -%}
        {%- assign button_breakpoints = "both" | split: "," -%}
      {%- else -%}
        {%- assign button_breakpoints = "desktop,mobile" | split: "," -%}
      {%- endif -%}

      {%- for breakpoint in button_breakpoints -%}
        {%- assign hide_class = "" -%}
        {%- case breakpoint -%}
          {%- when "mobile" -%}
            {%- assign current_style = mobile_style -%}
            {%- assign id_suffix = "--mobile" -%}
            {%- assign hide_class = "hide-desktop" -%}
          {%- when "desktop" -%}
            {%- assign current_style = desktop_style -%}
            {%- assign id_suffix = "" -%}
            {%- assign hide_class = "hide-mobile" -%}
          {%- else -%}
            {%- assign current_style = desktop_style -%}
            {%- assign id_suffix = "" -%}
        {%- endcase -%}

        {%- if block.settings.hide_desktop -%}{%- assign hide_class = hide_class | append: " hide-desktop" -%}{%- endif -%}
        {%- if block.settings.hide_mobile -%}{%- assign hide_class = hide_class | append: " hide-mobile" -%}{%- endif -%}

        {%- capture style_class -%}{% if current_style contains "link" %}link--{% if current_style == 'link-with-arrow-white' %}secondary{% elsif current_style == 'link-black' %}black{% elsif current_style == 'link-white' %}white{% else %}primary{% endif %}{% else %}button {{ current_style }}{% endif %}{%- endcapture -%}

        {%- if block.settings.modal_content != blank -%}
          <button class="blocks--button {{ classes }} {{ style_class }} {{ hide_class }}" id="block-{{ block.id }}{{ id_suffix }}" {% if block.settings.content_square_id %}data-content-square="{{ block.settings.content_square_id }}"{% endif %}>{{ block.settings.button_text }} {% if current_style contains "link-with-arrow" %}{%- render 'icon' with "brand-arrow-right" -%}{% endif %}</button>
        {%- else -%}
          <a class="blocks--button {{ classes }} {{ style_class }} {{ hide_class }}" href="{{ block.settings.button_link }}" id="block-{{ block.id }}{{ id_suffix }}">{{ block.settings.button_text }} {% if current_style contains "link-with-arrow" %}{%- render 'icon' with "brand-arrow-right" -%}{% endif %}</a>
        {%- endif -%}
      {%- endfor -%}

      {%- if block.settings.modal_content != blank -%}
        {%- assign modalId = block.id -%}
        {%- assign buttonId = block.id | prepend: "block-" -%}
        {%- assign buttonIdMobile = buttonId | append: "--mobile" -%}
        {%- render 'modal', modalId: modalId, content: block.settings.modal_content, buttonId: buttonId, buttonIdMobile: buttonIdMobile, content_square_id: block.settings.content_square_id, teleport: true -%}
      {%- endif -%}

      {% schema %}
        {
          "name": "Button",

          "settings": [
            {
            "type": "text",
            "id": "content_square_id",
            "label": "Content Square Button ID",
            "info": "Must match the 'Content Square' section in the header."
          },
          {
          "type": "checkbox",
          "id": "hide_mobile",
          "label": "Hide Mobile?"
        },
        {
          "type": "checkbox",
          "id": "hide_desktop",
          "label": "Hide Desktop?"
        },
          {
              "type": "text",
              "id": "button_text",
              "label": "Button text"
          },
          {
              "type": "url",
              "id": "button_link",
              "label": "Button link"
          },
          {
              "type": "radio",
              "id": "button_style",
              "label": "Button Style (Desktop)",
              "info": "Used on desktop, and on mobile unless overridden in the Mobile settings below.",
              "options": [
                {
                "value": "button--primary",
                "label": "Button"
              },
              {
                  "value": "button--secondary",
                  "label": "Button (Secondary)"
              },
              {
                  "value": "button--ternary",
                  "label": "Button (Ternary)"
              },
              {
                  "value": "button--ternary-white",
                  "label": "Button (Ternary - White)"
              },
              {
                  "value": "button--outline",
                  "label": "Button (Outline)"
              },
              {
                  "value": "link",
                  "label": "Link"
              },
              {
                  "value": "link-black",
                  "label": "Link (Black Underline)"
              },
              {
                  "value": "link-white",
                  "label": "Link (White Underline)"
              },
              {
                  "value": "link-with-arrow",
                  "label": "Link (With Arrow)"
              },
              {
              "value": "link-with-arrow-white",
              "label": "White Link (With Arrow)"
              }
              ],
              "default": "button--primary"
          },
          {
          "type": "header",
          "content": "🌫️ Modal"
          },
          {
            "type": "liquid",
            "id": "modal_content",
            "label": "Modal Content",
            "info": "Can also add HTML + Liquid Code"
          },
          {
          "type": "header",
          "content": "--- 🖥️ DESKTOP SETTINGS 🖥️  ---"
          },
          {
              "type": "header",
              "content": "Margins"
          },
          {
              "type": "range",
              "id": "margin_top_desktop",
              "min": 0,
              "max": 100,
              "step": 1,
              "unit": "px",
              "default": 0,
              "label": "⬆ Margin Top"
          },
          {
              "type": "range",
              "id": "margin_bottom_desktop",
              "min": 0,
              "max": 100,
              "step": 1,
              "unit": "px",
              "default": 0,
              "label": "⬇ Margin Bottom"
          },
          {
            "type": "select",
            "id": "flex_justify_content_desktop",
            "label": "Position",
            "info": "Position the button (Left, Center, Right)",
            "default": "unset",
            "options": [
              {
                "value": "unset",
                "label": "Unset"
              },
              {
                "value": "flex-start",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "flex-end",
                "label": "Right"
              }
            ]
          },
          {
            "type": "color",
            "id": "button_color_desktop",
            "label": "Button - Colour",
            "default": "#000000",
            "info": "Only works with button 'Outline' option"
          },
          {
              "type": "range",
              "id": "button_width_desktop",
              "min": 0,
              "max": 100,
              "step": 1,
              "unit": "vw",
              "default": 0,
              "label": "Button - Width",
              "info": "If 0, the button will automatically choose the width."
          },
          {
              "type": "header",
              "content": "--- 📱 MOBILE SETTINGS 📱 ---"
          },
          {
              "type": "select",
              "id": "button_style_mobile",
              "label": "Button Style (Mobile)",
              "info": "Overrides the desktop style on mobile. Leave as ‘Same as desktop’ to inherit.",
              "default": "inherit",
              "options": [
                {
                  "value": "inherit",
                  "label": "Same as desktop"
                },
                {
                  "value": "button--primary",
                  "label": "Button"
                },
                {
                  "value": "button--secondary",
                  "label": "Button (Secondary)"
                },
                {
                  "value": "button--ternary",
                  "label": "Button (Ternary)"
                },
                {
                  "value": "button--ternary-white",
                  "label": "Button (Ternary - White)"
                },
                {
                  "value": "button--outline",
                  "label": "Button (Outline)"
                },
                {
                  "value": "link",
                  "label": "Link"
                },
                {
                  "value": "link-black",
                  "label": "Link (Black Underline)"
                },
                {
                  "value": "link-white",
                  "label": "Link (White Underline)"
                },
                {
                  "value": "link-with-arrow",
                  "label": "Link (With Arrow)"
                },
                {
                  "value": "link-with-arrow-white",
                  "label": "White Link (With Arrow)"
                }
              ]
          },
          {
              "type": "range",
              "id": "margin_top_mobile",
              "min": 0,
              "max": 100,
              "step": 1,
              "unit": "px",
              "default": 0,
              "label": "⬆ Margin Top"
          },
          {
              "type": "range",
              "id": "margin_bottom_mobile",
              "min": 0,
              "max": 100,
              "step": 1,
              "unit": "px",
              "default": 0,
              "label": "⬇ Margin Bottom"
          },
          {
            "type": "select",
            "id": "flex_justify_content_mobile",
            "label": "Button Position",
            "info": "Position the button (Left, Center, Right)", 
            "default": "unset",
            "options": [
              {
                "value": "unset",
                "label": "Unset"
              },
              {
                "value": "flex-start",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "flex-end",
                "label": "Right"
              }
            ]
          },
          {
            "type": "color",
            "id": "button_color_mobile",
            "label": "Button - Colour",
            "default": "#000000",
            "info": "Only works with button 'Outline' option"
          },
          {
              "type": "range",
              "id": "button_width_mobile",
              "min": 0,
              "max": 100,
              "step": 1,
              "unit": "vw",
              "default": 0,
              "label": "Button - Width",
              "info": "If 0, the button will automatically choose the width."
          }
      
      
          ],
          "presets": [
            { "name": "Button" }
          ]
        }
        {% endschema %}
        
