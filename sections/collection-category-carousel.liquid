{%- if section.settings.background != settings.background and section.settings.background != 'rgba(0,0,0,0)' -%}
  {%- assign blends_with_background = false -%}
{%- else -%}
  {%- assign blends_with_background = true -%}
{%- endif -%}

{%- if section.settings.background == 'rgba(0,0,0,0)' -%}
  {%- assign section_background = settings.background -%}
{%- else -%}
  {%- assign section_background = section.settings.background -%}
{%- endif -%}

{%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
  {%- assign heading_color = settings.heading_color -%}
  {%- assign text_color = settings.text_color -%}
{%- else -%}
  {%- assign heading_color = section.settings.text_color -%}
  {%- assign text_color = section.settings.text_color -%}
{%- endif -%}

<style>
  /* Collapse the whole section when no block matched the current collection —
     the _category-carousel-collections block only renders .category-carousel
     when it resolves to visible, so its absence means nothing to show. */
  #shopify-section-{{ section.id }}:not(:has(.category-carousel)) {
    display: none;
  }

  #shopify-section-{{ section.id }} {
    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --prev-next-button-background: {{ settings.background.red }}, {{ settings.background.green }}, {{ settings.background.blue }};
    --prev-next-button-color: {{ settings.text_color.red }}, {{ settings.text_color.green }}, {{ settings.text_color.blue }};
    --section-products-per-row: 2;
    --section-products-per-row-mobile: {{ section.settings.mobile_card_width }}vw;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} {
      --section-products-per-row: {{ section.settings.cards_per_row | at_most: 3 }};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --section-products-per-row: {{ section.settings.cards_per_row | at_most: 5 }};
    }
  }

  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} {
      --section-products-per-row: {{ section.settings.cards_per_row }};
    }
  }

  #shopify-section-{{ section.id }} .category-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
    aspect-ratio: 5 / 4;
    text-decoration: none;
    color: inherit;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .category-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .category-card__label {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 15px;
    background: {{ section.settings.label_background }};
    color: {{ section.settings.label_text_color }};
    font-family: var(--heading-font-family);
    font-style: italic;
    font-size: 18px;
    line-height: 1;
    white-space: nowrap;
    font-weight: 400;

  }

  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} .category-card__label {
      padding: 10px 12px;
      font-size: 15px;
    }
  }

  /* Carousel wrapper sits flush with the container — no centered text-container */
  #shopify-section-{{ section.id }} .category-carousel {
    text-align: left;
  }

  /* Left-align cards: drop the 28px scroller indent and any centering */
  #shopify-section-{{ section.id }} .category-carousel .product-list__inner {
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .category-carousel .product-list__inner--scroller {
    margin-inline-start: 0;
    margin-inline-end: 0;
  }

  /* Prev/next arrows — match Figma "Icon/Arrow Button": 45px Barely Pink circle,
     elevation shadow, no border. Background comes from the chevron SVG's own rect.
     Vertically centered and held 40px (the container gutter) inside the container. */
  #shopify-section-{{ section.id }} .category-carousel .product-list__prev-next {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    margin: 0;
    width: 100%;
    box-sizing: border-box;
    padding-inline: 3px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow {
    pointer-events: auto;
    width: 45px;
    height: 45px;
    padding: 0;
    background: transparent !important;
    border: 0 !important;
    border-radius: 50% !important;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity .2s ease;
  }

  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow svg {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    box-shadow: 0 2px 4px -4px rgba(52, 52, 52, 0.16), 0 1px 2px 0 rgba(52, 52, 52, 0.24);
  }

  /* Kill the theme's slide-across (translateX) keyframe on hover — the only
     hover feedback here is the opacity fade on the button. */
  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow:hover svg {
    animation: none;
  }

  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow svg rect {
    fill: #FEF9F8;
  }

  /* Hide an arrow once it can't go further — so the prev arrow is hidden until
     you've scrolled right (and the next arrow hides at the end). opacity:0 (rather
     than visibility:hidden) lets it fade out/in over the .2s opacity transition,
     while still keeping its layout slot so the opposite arrow stays pinned to its
     edge. The :hover-scoped selector beats the carousel-hover rule below, which
     would otherwise force a disabled arrow back to full opacity. */
  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow[disabled],
  #shopify-section-{{ section.id }} .category-carousel:hover .product-list__arrow[disabled] {
    opacity: 0 !important;
    pointer-events: none;
  }

  /* The theme only reveals these arrows on hover, and that whole mechanism
     lives in a min-width:1000 query — so by default (and on touch, where there
     is no hover) the arrows never show. Pin them visible at every width. The
     [disabled] rule above still wins on specificity, so the prev arrow stays
     hidden until you've scrolled right. */
  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow {
    opacity: 0.7 !important;
    visibility: visible;
    transform: none;
  }

  #shopify-section-{{ section.id }} .category-carousel:hover .product-list__arrow {
    opacity: 1 !important;
  }

  /* Right-side breakout (desktop): cards keep their container width, but the row
     bleeds out to the viewport's right edge so the next card peeks past the
     container line. Left edge stays aligned to the container. Declared after the
     base arrow rule so this width wins over the base width:100%. */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .category-carousel {
      margin-inline-end: calc(-1 * var(--container-outer-width));
    }

    #shopify-section-{{ section.id }} .category-carousel .product-list__inner--scroller {
      grid-auto-columns: calc(var(--container-inner-width) / var(--section-products-per-row) - var(--product-list-column-gap) * (var(--section-products-per-row) - 1) / var(--section-products-per-row));
      /* Breathing room after the last card so it lands at the container edge
         (not jammed against the screen) when scrolled to the end. */
      padding-inline-end: var(--container-outer-width);
    }

    /* Constrain the arrow bar to the container width so the arrows stay inside it
       (40px in via the padding-inline above) instead of riding the bled-out edge. */
    #shopify-section-{{ section.id }} .category-carousel .product-list__prev-next {
      width: var(--container-inner-width);
    }
  }

  /* On mobile the theme sets `min-width: min-content` on the scroller, which
     makes it expand to the full width of all its cards. The inner element
     therefore has scrollWidth === clientWidth (nothing overflows *inside* it —
     the overflow lands on the outer .scroller instead), so native swipe works
     but the arrows' scrollBy() — which targets this inner element — is a no-op.
     Constrain it to the container (as it already is at >=1000px, where the
     arrows work) so it becomes the scroll container the arrows can drive. */
  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .category-carousel .product-list__inner--scroller {
      min-width: 0;
      overflow-x: auto;
      overflow-y: hidden;
      padding-left: 20px;
    }
  }

  /* Hide arrows entirely when content fits without scrolling */
  /* #shopify-section-{{ section.id }} .category-carousel[data-no-scroll] .product-list__prev-next {
    display: none;
  } */

  /* Page-load reveal — mirrors the product-item stagger (opacity 0→1 +
     translateY→0, 600ms ease, staggered). Plays once the carousel scrolls into
     view; the per-card delay is set inline by the script below. */
  @keyframes category-card-reveal {
    from { opacity: 0; transform: translateY(60px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media screen and (max-width: 999px) {
    @keyframes category-card-reveal {
      from { opacity: 0; transform: translateY(35px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }
  #shopify-section-{{ section.id }} .category-carousel.is-reveal-ready .category-card {
    opacity: 0;
  }
  #shopify-section-{{ section.id }} .category-carousel .category-card--reveal {
    opacity: 1;
    animation: category-card-reveal 600ms ease both;
    animation-delay: var(--cat-reveal-delay, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    @keyframes category-card-reveal {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    #shopify-section-{{ section.id }} .category-carousel .category-card--reveal {
      animation-delay: 0ms;
    }
  }
</style>

<section class=" {% if section.settings.hide_desktop %}hide-desktop{% endif %} {% if section.settings.hide_mobile %}hide-mobile{% endif %} {% unless blends_with_background %}section--flush{% endunless %}" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="section__color-wrapper">
    <div class="container {% unless blends_with_background %}vertical-breather{% endunless %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var carousel = section.querySelector('.category-carousel');
    if (!carousel) return;
    var scroller = carousel.querySelector('.product-list__inner');
    if (!scroller) return;

    function update() {
      // Skip while the carousel is laid out at zero width — e.g. in a hidden
      // tab, or mid-injection in the theme editor. Measuring then would wrongly
      // conclude the content fits and hide the arrows for good.
      if (scroller.clientWidth === 0) return;
      var canScroll = scroller.scrollWidth - scroller.clientWidth > 1;
      carousel.toggleAttribute('data-no-scroll', !canScroll);
    }

    update();
    // Re-measure after the first layout pass and once images/fonts have loaded,
    // so an early zero-width or pre-layout reading can't leave the arrows hidden.
    requestAnimationFrame(update);
    window.addEventListener('load', update);
    window.addEventListener('resize', update);
    if (window.ResizeObserver) {
      new ResizeObserver(update).observe(scroller);
    }

    // Page-load reveal — mirror the product-item stagger: hold the cards hidden,
    // then fade + slide each up once the carousel scrolls into view, with the
    // same decelerating per-card delay (100·i − min(3·i², 100·i)).
    var cards = Array.prototype.slice.call(scroller.querySelectorAll('.category-card'));
    if (cards.length) {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      carousel.classList.add('is-reveal-ready');
      var play = function () {
        cards.forEach(function (card, i) {
          var delay = reduce ? 0 : 100 * i - Math.min(3 * i * i, 100 * i);
          card.style.setProperty('--cat-reveal-delay', Math.max(0, delay) + 'ms');
          card.classList.add('category-card--reveal');
        });
      };
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries, obs) {
          if (entries[0].isIntersecting) { play(); obs.disconnect(); }
        }, { threshold: 0.1 }).observe(carousel);
      } else {
        play();
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Collection Category",
  "class": "shopify-section--category-carousel",
  "max_blocks": 12,
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "blocks": [
    { "type": "_category-carousel-collections" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "id",
      "label": "ID",
      "info": "Optional. Used with in-page navigation."
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide Mobile?"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide Desktop?"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "label": "Cards per row (desktop)",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Card width (mobile)",
      "min": 30,
      "max": 90,
      "step": 1,
      "default": 45,
      "unit": "%",
      "info": "Percentage of viewport width. Smaller = more peek of the next card."
    },
    {
      "type": "text",
      "id": "card_aspect_ratio",
      "label": "Card aspect ratio",
      "default": "1 / 1",
      "info": "CSS aspect-ratio value. e.g. 1 / 1, 4 / 5, 3 / 4."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Label background",
      "default": "#FAF2EC"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading / text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "Collection Category",
      "blocks": [
        { "type": "_category-carousel-collections" }
      ]
    }
  ]
}
{% endschema %}
