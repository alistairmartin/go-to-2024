{%- assign show_collections = false -%}
{%- if block.settings.collections.size == 0 -%}
  {%- assign show_collections = true -%}
{%- else -%}
  {%- for col in block.settings.collections -%}
    {%- if collection.handle != blank and col.handle == collection.handle -%}
      {%- assign show_collections = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if show_collections -%}
  <product-list data-scroll-step="item" class="product-list category-carousel" {{ block.shopify_attributes }}>
    <div class="scroller">
      <div class="product-list__inner product-list__inner--scroller hide-scrollbar">
        {% content_for 'blocks' %}
      </div>
    </div>

    {%- if block.blocks.size > 1 -%}
      <prev-next-buttons class="product-list__prev-next">
        <button class="product-list__arrow prev-next-button prev-next-button--prev" disabled>
          <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
          {%- render 'icon' with 'brand-chevron-left', block: true, direction_aware: true -%}
        </button>

        <button class="product-list__arrow prev-next-button prev-next-button--next">
          <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
          {%- render 'icon' with 'brand-chevron-right', block: true, direction_aware: true -%}
        </button>
      </prev-next-buttons>
    {%- endif -%}
  </product-list>
{%- endif -%}

{% schema %}
{
  "name": "Collections",
  "blocks": [{ "type": "_category-carousel-card" }],
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Display on these collections",
      "info": "The cards in this block will only show on collection pages selected here. Leave empty to show on all pages."
    }
  ],
  "presets": [
    {
      "name": "Collection Select",
      "blocks": [
        { "type": "_category-carousel-card" }
      ]
    }
  ]
}
{% endschema %}
