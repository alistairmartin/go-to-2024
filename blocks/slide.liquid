  <style>
    .custom-slideshow--slide .slide-video-toggle {
      --toggle-inset: 20px;
      display: none;
      position: absolute;
      inset: auto var(--toggle-inset) var(--toggle-inset) auto;
      transform: none;
      z-index: 4;
      width: 44px;
      height: 44px;
      padding: 0;
      margin: 0;
      border: 2px solid #fff;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.55);
      color: #fff;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      -webkit-appearance: none;
      appearance: none;
      -webkit-tap-highlight-color: transparent;
    }
    .custom-slideshow--slide .slide-video-toggle.is-visible { display: flex; }
    /* Button position: mobile below 740px, desktop at 740px and up */
    @media only screen and (max-width: 739px) {
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="top_left"] { inset: var(--toggle-inset) auto auto var(--toggle-inset); transform: none; }
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="top_center"] { inset: var(--toggle-inset) auto auto 50%; transform: translateX(-50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="top_right"] { inset: var(--toggle-inset) var(--toggle-inset) auto auto; transform: none; }
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="middle_left"] { inset: 50% auto auto var(--toggle-inset); transform: translateY(-50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="middle_center"] { inset: 50% auto auto 50%; transform: translate(-50%, -50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="middle_right"] { inset: 50% var(--toggle-inset) auto auto; transform: translateY(-50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="bottom_left"] { inset: auto auto var(--toggle-inset) var(--toggle-inset); transform: none; }
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="bottom_center"] { inset: auto auto var(--toggle-inset) 50%; transform: translateX(-50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-mobile="bottom_right"] { inset: auto var(--toggle-inset) var(--toggle-inset) auto; transform: none; }
    }
    @media only screen and (min-width: 740px) {
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="top_left"] { inset: var(--toggle-inset) auto auto var(--toggle-inset); transform: none; }
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="top_center"] { inset: var(--toggle-inset) auto auto 50%; transform: translateX(-50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="top_right"] { inset: var(--toggle-inset) var(--toggle-inset) auto auto; transform: none; }
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="middle_left"] { inset: 50% auto auto var(--toggle-inset); transform: translateY(-50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="middle_center"] { inset: 50% auto auto 50%; transform: translate(-50%, -50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="middle_right"] { inset: 50% var(--toggle-inset) auto auto; transform: translateY(-50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="bottom_left"] { inset: auto auto var(--toggle-inset) var(--toggle-inset); transform: none; }
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="bottom_center"] { inset: auto auto var(--toggle-inset) 50%; transform: translateX(-50%); }
  .custom-slideshow--slide .slide-video-toggle[data-pos-desktop="bottom_right"] { inset: auto var(--toggle-inset) var(--toggle-inset) auto; transform: none; }
    }
    .custom-slideshow--slide .slide-video-toggle svg { width: 22px; height: 22px; display: block; }
    .custom-slideshow--slide .slide-video-toggle .slide-video-toggle__pause { display: none; }
    .custom-slideshow--slide .slide-video-toggle.is-playing .slide-video-toggle__play { display: none; }
    .custom-slideshow--slide .slide-video-toggle.is-playing .slide-video-toggle__pause { display: block; }
    .custom-slideshow--slide .slide-video-toggle:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .custom-slideshow--slide-video .slide-video-poster {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      opacity: 1;
      transition: opacity 0.3s ease;
    }
    .custom-slideshow--slide-video .slide-video-poster img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .custom-slideshow--slide-video .slide-video-poster.is-hidden { opacity: 0; }
    .custom-slideshow--slide-video video { -webkit-appearance: none; appearance: none; }
    /* Hide iOS Safari's native centre play overlay when autoplay is blocked */
    .custom-slideshow--slide-video video::-webkit-media-controls-start-playback-button,
    .custom-slideshow--slide-video video::-webkit-media-controls-overlay-play-button,
    .custom-slideshow--slide-video video::-webkit-media-controls-panel,
    .custom-slideshow--slide-video video::-webkit-media-controls {
      display: none !important;
      -webkit-appearance: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  </style>
  <script>
    (function () {
      function init() {
        var container = document.getElementById('video-container-{{ block.id }}');
        var btn = document.getElementById('video-toggle-{{ block.id }}');
        if (!container || !btn || btn.dataset.bound) return;
        btn.dataset.bound = 'true';

        var videos = Array.prototype.slice.call(container.querySelectorAll('video'));
        if (!videos.length) return;

        var userControlled = false;

        function activeVideo() {
          for (var i = 0; i < videos.length; i++) {
            if (window.getComputedStyle(videos[i]).display !== 'none') return videos[i];
          }
          return videos[0];
        }

        var poster = document.getElementById('video-poster-{{ block.id }}');

        function setState(playing) {
          btn.classList.toggle('is-playing', playing);
          btn.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
          if (poster) poster.classList.toggle('is-hidden', playing);
        }

        function showButton() {
          btn.classList.add('is-visible');
        }

        // Low power mode / autoplay blocked: play() rejects, or the video never leaves paused.
        function probeAutoplay() {
          if (userControlled) return;
          var v = activeVideo();
          if (!v.paused) { setState(true); return; }
          var p;
          try { p = v.play(); } catch (e) { showButton(); setState(false); return; }
          if (p && typeof p.catch === 'function') {
            p.then(function () { btn.classList.add('is-playing'); }).catch(function () { showButton(); setState(false); });
          } else if (v.paused) {
            showButton(); setState(false);
          }
        }

        videos.forEach(function (v) {
          v.addEventListener('playing', function () { setState(true); });
          v.addEventListener('pause', function () { setState(false); });
          // iOS Low Power Mode fires suspend and leaves the video paused
          v.addEventListener('suspend', function () { if (v.paused) probeAutoplay(); });
          v.addEventListener('loadedmetadata', probeAutoplay);
        });

        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          userControlled = true;
          var v = activeVideo();
          if (v.paused) {
            var p = v.play();
            if (p && typeof p.catch === 'function') p.catch(function () { setState(false); });
          } else {
            v.pause();
          }
        });

        // Fallback probe in case no media events fire
        setTimeout(probeAutoplay, 1500);
        setTimeout(probeAutoplay, 4000);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      document.addEventListener('shopify:section:load', init);
    })();
  </script>
