{%- if section.settings.background != settings.background and section.settings.background != 'rgba(0,0,0,0)' -%}
  {%- assign blends_with_background = false -%}
{%- else -%}
  {%- assign blends_with_background = true -%}
{%- endif -%}

{%- if section.settings.background == 'rgba(0,0,0,0)' -%}
  {%- assign section_background = settings.background -%}
{%- else -%}
  {%- assign section_background = section.settings.background -%}
{%- endif -%}

{%- if section.settings.text_color == 'rgba(0,0,0,0)' -%}
  {%- assign heading_color = settings.heading_color -%}
  {%- assign text_color = settings.text_color -%}
{%- else -%}
  {%- assign heading_color = section.settings.text_color -%}
  {%- assign text_color = section.settings.text_color -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    --heading-color: {{ heading_color.red }}, {{ heading_color.green }}, {{ heading_color.blue }};
    --text-color: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
    --section-background: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --prev-next-button-background: {{ settings.background.red }}, {{ settings.background.green }}, {{ settings.background.blue }};
    --prev-next-button-color: {{ settings.text_color.red }}, {{ settings.text_color.green }}, {{ settings.text_color.blue }};
    --section-products-per-row: 2;
    --section-products-per-row-mobile: {{ section.settings.mobile_card_width }}vw;
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} {
      --section-products-per-row: {{ section.settings.cards_per_row | at_most: 3 }};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --section-products-per-row: {{ section.settings.cards_per_row | at_most: 5 }};
    }
  }

  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} {
      --section-products-per-row: {{ section.settings.cards_per_row }};
    }
  }

  #shopify-section-{{ section.id }} .category-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
    aspect-ratio: {{ section.settings.card_aspect_ratio }};
    text-decoration: none;
    color: inherit;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .category-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .category-card__label {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 15px;
    background: {{ section.settings.label_background }};
    color: {{ section.settings.label_text_color }};
    font-family: var(--heading-font-family);
    font-style: italic;
    font-size: 18px;
    line-height: 1;
    white-space: nowrap;
  }

  @media screen and (max-width: 740px) {
    #shopify-section-{{ section.id }} .category-card__label {
      padding: 10px 12px;
      font-size: 15px;
    }
  }

  /* Carousel wrapper sits flush with the container — no centered text-container */
  #shopify-section-{{ section.id }} .category-carousel {
    text-align: left;
  }

  /* Left-align cards: drop the 28px scroller indent and any centering */
  #shopify-section-{{ section.id }} .category-carousel .product-list__inner {
    justify-content: flex-start;
  }

  #shopify-section-{{ section.id }} .category-carousel .product-list__inner--scroller {
    margin-inline-start: 0;
    margin-inline-end: 0;
  }

  /* Prev/next arrows — match Figma "Icon/Arrow Button": 45px Barely Pink circle,
     elevation shadow, no border. Background comes from the chevron SVG's own rect.
     Vertically centered and held 40px (the container gutter) inside the container. */
  #shopify-section-{{ section.id }} .category-carousel .product-list__prev-next {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    margin: 0;
    width: 100%;
    box-sizing: border-box;
    padding-inline: var(--container-gutter);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow {
    pointer-events: auto;
    width: 45px;
    height: 45px;
    padding: 0;
    background: transparent !important;
    border: 0 !important;
    border-radius: 50% !important;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity .2s ease;
  }

  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow svg {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    box-shadow: 0 2px 4px -4px rgba(52, 52, 52, 0.16), 0 1px 2px 0 rgba(52, 52, 52, 0.24);
  }

  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow svg rect {
    fill: #FEF9F8;
  }

  /* Hide an arrow once it can't go further — so the prev arrow is hidden until
     you've scrolled right (and the next arrow hides at the end). visibility keeps
     its slot so the opposite arrow stays pinned to its edge. */
  #shopify-section-{{ section.id }} .category-carousel .product-list__arrow[disabled] {
    visibility: hidden;
    pointer-events: none;
  }

  /* Right-side breakout (desktop): cards keep their container width, but the row
     bleeds out to the viewport's right edge so the next card peeks past the
     container line. Left edge stays aligned to the container. Declared after the
     base arrow rule so this width wins over the base width:100%. */
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .category-carousel {
      margin-inline-end: calc(-1 * var(--container-outer-width));
    }

    #shopify-section-{{ section.id }} .category-carousel .product-list__inner--scroller {
      grid-auto-columns: calc(var(--container-inner-width) / var(--section-products-per-row) - var(--product-list-column-gap) * (var(--section-products-per-row) - 1) / var(--section-products-per-row));
      /* Breathing room after the last card so it lands at the container edge
         (not jammed against the screen) when scrolled to the end. */
      padding-inline-end: var(--container-outer-width);
    }

    /* Constrain the arrow bar to the container width so the arrows stay inside it
       (40px in via the padding-inline above) instead of riding the bled-out edge. */
    #shopify-section-{{ section.id }} .category-carousel .product-list__prev-next {
      width: var(--container-inner-width);
    }
  }

  /* Hide arrows entirely when content fits without scrolling */
  #shopify-section-{{ section.id }} .category-carousel[data-no-scroll] .product-list__prev-next {
    display: none;
  }
</style>

<section class="section {% if section.settings.hide_desktop %}hide-desktop{% endif %} {% if section.settings.hide_mobile %}hide-mobile{% endif %} {% unless blends_with_background %}section--flush{% endunless %}" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="section__color-wrapper">
    <div class="container {% unless blends_with_background %}vertical-breather{% endunless %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var carousel = section.querySelector('.category-carousel');
    if (!carousel) return;
    var scroller = carousel.querySelector('.product-list__inner');
    if (!scroller) return;

    function update() {
      var canScroll = scroller.scrollWidth - scroller.clientWidth > 1;
      carousel.toggleAttribute('data-no-scroll', !canScroll);
    }

    update();
    window.addEventListener('resize', update);
    if (window.ResizeObserver) {
      new ResizeObserver(update).observe(scroller);
    }
  })();
</script>

{% schema %}
{
  "name": "Collection Category",
  "class": "shopify-section--category-carousel",
  "max_blocks": 12,
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "blocks": [
    { "type": "_category-carousel-collections" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "id",
      "label": "ID",
      "info": "Optional. Used with in-page navigation."
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide Mobile?"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide Desktop?"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "label": "Cards per row (desktop)",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "Card width (mobile)",
      "min": 30,
      "max": 90,
      "step": 1,
      "default": 45,
      "unit": "%",
      "info": "Percentage of viewport width. Smaller = more peek of the next card."
    },
    {
      "type": "text",
      "id": "card_aspect_ratio",
      "label": "Card aspect ratio",
      "default": "1 / 1",
      "info": "CSS aspect-ratio value. e.g. 1 / 1, 4 / 5, 3 / 4."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Label background",
      "default": "#FAF2EC"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading / text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    }
  ],
  "presets": [
    {
      "name": "Collection Category",
      "blocks": [
        { "type": "_category-carousel-collections" }
      ]
    }
  ]
}
{% endschema %}
