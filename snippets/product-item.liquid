{%- comment -%}
  Collection product card (V3 design — "Shop All" 25/26 refresh).

  A bespoke card for the collection grid that matches the new Figma styling:
  title + price on one row, muted subtitle, peach star rating, variant chips /
  colour swatches, and an underline "+ ADD TO CART" CTA. Left-aligned.

  Data logic (badges, sold out / waitlist, swatch image-swap, quick-buy drawers,
  ATC form, price formatting) is preserved from `product-item.liquid` so the
  shared `product-item` custom element JS keeps working — only the markup order
  inside `.product-item__info` differs.

  Accepts the same params as `product-item`: product, collection, sizes_attribute,
  reveal, showWishlist (default true).
{%- endcomment -%}

{%- if showWishlist == false -%}
  {%- assign showWishlist = false -%}
{% else %}
  {%- assign showWishlist = true -%}
{%- endif -%}

{%- assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ',' -%}
{%- assign color_white_label = 'general.label.white' | t | downcase -%}

{%- if product.vendor contains "Go-To" -%}
  {%- assign productBrand = "Go-To" -%}
{% elsif product.vendor contains "Bro-To" %}
  {%- assign productBrand = "Bro-To" -%}
{% elsif product.vendor contains "Gro-To" %}
  {%- assign productBrand = "Gro-To" -%}
{%- endif -%}

{%- if product.tags contains "hidden" or product.template_suffix == "hidden" -%}
  {%- assign hideProduct = true -%}
{%- endif -%}

{%- if showHiddenProduct -%}
  {%- assign hideProduct = false -%}
{%- endif -%}

{%- if template.suffix contains "vip-access" -%}
  {%- capture vipCustomer -%}{% render "vip-access--validator", variable: true %}{%- endcapture -%}
  {%- if vipCustomer contains "true" -%}
    {%- assign hideProduct = false -%}
  {%- endif -%}
{%- endif -%}

{%- unless hideProduct -%}
<product-item class="product-item product-card product-brand--{{ productBrand | handle }} product-item--{{ product.template_suffix | handle }} {% unless product.available %}product-item--sold-out{% endunless %} {% if mobile_swipe == false %}product-card--no-mobile-swipe{% endif %}" {% if reveal %}reveal{% endif %} data-title="{{ product.title }}">

  {%- comment -%} -------- Labels / badges -------- {%- endcomment -%}
  {%- capture product_labels -%}
    {%- if product.template_suffix == 'coming-soon' -%}
      <span class="label label--label-custom label--coming-soon">{{ 'product.labels.coming_soon' | t }}</span>
    {%- elsif product.available == false -%}
      {% assign noWaitlist = false %}
      {%- if product.tags contains 'no-waitlist' -%}{% assign noWaitlist = true %}{%- endif -%}
      <span class="label label--label-custom label--waitlist {% if noWaitlist == true %}hide{% endif %}">{{ 'product.labels.waitlist' | t }}</span>
      <span class="label label--label-custom label--soldout {% if noWaitlist == false %}hide{% endif %}">{{ 'product.labels.sold_out' | t }}</span>
    {%- elsif product.metafields.gts_theme.label != blank -%}
      <span class="label label--label-custom label--{{ product.metafields.gts_theme.label | handle }}">{{ product.metafields.gts_theme.label }}</span>
    {%- endif -%}

    {%- if product.metafields.gts_theme.label2 != blank -%}
      <span class="label label--label-custom label--{{ product.metafields.gts_theme.label2 | handle }}">{{ product.metafields.gts_theme.label2 }}</span>
    {%- endif -%}

    {%- if product.metafields.custom.badges != blank -%}
      {%- for custom_badge in product.metafields.custom.badges.value -%}
        <span class="label {% if forloop.index == 1 %}label--custom{% else %}label--custom2{% endif %}">{{ custom_badge }}</span>
      {%- endfor -%}
    {%- endif -%}

    {%- for tag in product.tags -%}
      {%- if tag contains '__label' -%}
        <span class="label label--label-custom label--{{ tag | split: ':' | last | handle }}">{{ tag | split: ':' | last }}</span>
      {%- endif -%}
    {%- endfor -%}

    {%- assign cheapest_variant = product.variants | sort: 'price' | first -%}
    {%- if settings.show_discount and product.available and product.price < product.compare_at_price and cheapest_variant.compare_at_price != blank -%}
      {%- if settings.discount_mode == 'percentage' -%}
        {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round | append: '%' -%}
      {%- else -%}
        {%- capture savings -%}{{ product.compare_at_price | minus: product.price | money | remove: ".00" | remove: ",00" }}{%- endcapture -%}
      {%- endif -%}
      <span class="label label--highlight">{{ 'collection.product.discount_html' | t: savings: savings }}</span>
    {%- endif -%}
  {%- endcapture -%}

  {%- comment -%} -------- Media -------- {%- endcomment -%}
  <div class="product-card__media product-item__image-wrapper {% if settings.show_secondary_image and product.media.size > 1 and hide_secondary_image != true %}product-item__image-wrapper--multiple{% endif %}">
    {%- if product_labels != blank -%}
      <div class="product-card__labels product-item__label-list label-list">{{- product_labels -}}</div>
    {%- endif -%}

    {%- if showWishlist -%}
      <rivo-favorite-button
        class="product-card__wish"
        data-product-id="{{ product.id }}"
        rivo-ax-data
        rivo-ax-cloak
        rivo-ax-html="$store.icons.heart"
        rivo-ax-show="$store.rivo_aw_settings?.favorites_enabled && (!$store.rivo_profile_customer || $store.loading_states.global_favorite_buttons)"
      >
        {%- render 'icon' with 'go-to-wishlist' -%}
      </rivo-favorite-button>
    {%- endif -%}

    <a href="{{ product.url }}" data-instant class="product-card__aspect-ratio product-item__aspect-ratio aspect-ratio {% if settings.product_image_size != 'natural' %}aspect-ratio--{{ settings.product_image_size }}{% endif %}" style="padding-bottom: {{ 100.0 | divided_by: product.featured_media.preview_image.aspect_ratio }}%; --aspect-ratio: {{ product.featured_media.preview_image.aspect_ratio }}">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: product.featured_media.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,900,1000,1100,1200', class: 'product-item__primary-image', data-media-id: product.featured_media.id }}
      {%- endif -%}

      {%- if settings.product_color_display == 'swatch' -%}
        {%- for color_label in color_label_list -%}
          {%- if product.options_by_name[color_label] != blank -%}
            {%- for color_option in product.options_by_name[color_label].values -%}
              {%- for variant in product.variants -%}
                {%- if variant.options contains color_option and variant.featured_media != blank -%}
                  {%- unless variant.featured_media == product.featured_media -%}
                    {{ variant.featured_media | image_url: width: variant.featured_media.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,900,1000,1100,1200', class: 'product-item__primary-image', data-media-id: variant.featured_media.id, hidden: true }}
                    {% break %}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if settings.show_secondary_image and product.media.size > 1 and hide_secondary_image != true -%}
        {%- assign next_media = product.media[product.featured_media.position] | default: product.media[1] -%}
        {%- comment %} Metafield overrides which image shows on hover (1-based image number) {% endcomment -%}
        {%- if product.metafields.custom.collection_2nd_image != blank -%}
          {%- assign collection_2nd_index = product.metafields.custom.collection_2nd_image.value | times: 1 | minus: 1 -%}
          {%- if product.media[collection_2nd_index] != blank -%}
            {%- assign next_media = product.media[collection_2nd_index] -%}
          {%- endif -%}
        {%- endif -%}
        {{- next_media | image_url: width: next_media.width | image_tag: loading: 'lazy', sizes: sizes_attribute, widths: '200,300,400,500,600,700,800,900,1000,1100,1200', class: 'product-item__secondary-image' -}}
      {%- endif -%}
    </a>

    {%- comment -%}
      Mobile swipe gallery — native scroll-snap, synced arrows + dots.
      Skipped when `mobile_swipe: false` is passed (e.g. inside sections whose
      product list is itself a swipe carousel, so the card shouldn't capture the
      horizontal swipe). The static aspect-ratio image is shown on mobile instead.
    {%- endcomment -%}
    {%- if product.images.size > 0 and mobile_swipe != false -%}
      {%- comment %} Second swipe slide respects the collection_2nd_image metafield (1-based image number) when set {% endcomment -%}
      {%- assign second_slide_image = product.images[1] -%}
      {%- if product.metafields.custom.collection_2nd_image != blank -%}
        {%- assign collection_2nd_index = product.metafields.custom.collection_2nd_image.value | times: 1 | minus: 1 -%}
        {%- if product.images[collection_2nd_index] != blank -%}
          {%- assign second_slide_image = product.images[collection_2nd_index] -%}
        {%- endif -%}
      {%- endif -%}
      <card-slider class="product-card__slider">
        <div class="product-card__track" data-cs-track>
          <a href="{{ product.url }}" data-instant class="product-card__slide" tabindex="-1" aria-hidden="true">
            {{ product.images[0] | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,400,500,600,700,800', sizes: '50vw', class: 'product-card__slide-img' }}
          </a>
          {%- if second_slide_image != blank -%}
            <a href="{{ product.url }}" data-instant class="product-card__slide" tabindex="-1" aria-hidden="true">
              {{ second_slide_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,400,500,600,700,800', sizes: '50vw', class: 'product-card__slide-img' }}
            </a>
          {%- endif -%}
        </div>

        {%- assign slide_count = product.images.size -%}
        {%- if slide_count > 1 -%}
          <div class="product-card__dots" data-cs-dots aria-hidden="true">
            {%- for image in product.images limit: 2 -%}
              <span class="product-card__dot {% if forloop.first %}is-active{% endif %}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </card-slider>
    {%- endif -%}

    {%- comment -%}
      Per-variant secondary image (data source only, hidden).
      Image alts follow "#{Option}_{Value}" (e.g. "#Shade_Rosy"). For each colour
      value we grab the FIRST image carrying that shade's alt which ISN'T the
      variant's featured image, so the swatch handler (products.js) can use it as
      the gallery's 2nd image when that swatch is selected.
    {%- endcomment -%}
    {%- if settings.product_color_display == 'swatch' -%}
      {%- for color_label in color_label_list -%}
        {%- if product.options_by_name[color_label] != blank -%}
          {%- assign product_option = product.options_by_name[color_label] -%}
          {%- assign variant_option = 'option' | append: product_option.position -%}
          {%- for value in product_option.values -%}
            {%- assign variant_for_value = product.variants | where: variant_option, value | first -%}
            {%- if variant_for_value.featured_media == blank -%}{%- continue -%}{%- endif -%}
            {%- assign shade_alt = '#' | append: product_option.name | append: '_' | append: value -%}
            {%- assign featured_src = variant_for_value.featured_media.preview_image.src -%}
            {%- for image in product.images -%}
              {%- if image.alt == shade_alt and image.src != featured_src -%}
                {{ image | image_url: width: image.width | image_tag: loading: 'lazy', widths: '200,300,400,500,600,700,800,900,1000,1100,1200', sizes: sizes_attribute, class: 'product-item__variant-secondary-source', data-secondary-for: variant_for_value.featured_media.id, hidden: true }}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} Inline card video (metafield custom.collection_card_video) {%- endcomment -%}
    {%- assign card_video = product.metafields.custom.collection_card_video.value -%}
    {%- assign card_video_has_audio = product.metafields.custom.collection_card_video_has_audio.value -%}
    {%- if card_video != blank and disable_card_video != true -%}
      <collection-card-video class="product-card__video is-muted">
        <button type="button" class="product-card__video-play" data-cv-play aria-label="Play video">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>
        </button>
        <div class="product-card__video-stage" data-cv-stage hidden>
          {%- if card_video.sources != blank -%}
            {{- card_video | video_tag: class: 'product-card__video-player', muted: true, loop: true, playsinline: true, controls: false, preload: 'none' -}}
          {%- else -%}
            <video class="product-card__video-player" muted loop playsinline preload="none">
              <source src="{{ card_video | file_url }}" type="{{ card_video.mime_type }}">
            </video>
          {%- endif -%}
          <div class="product-card__video-controls">
            {%- if card_video_has_audio -%}
              <button type="button" class="product-card__video-ctl product-card__video-ctl--sound" data-cv-sound aria-label="Toggle sound">
                <svg class="cv-icon cv-icon--muted" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 9v6h4l5 5V4L7 9 3 9z" fill="currentColor"></path><path d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                <svg class="cv-icon cv-icon--unmuted" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 9v6h4l5 5V4L7 9 3 9z" fill="currentColor"></path><path d="M16.5 8.5a5 5 0 010 7M19 6a8 8 0 010 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
              </button>
            {%- endif -%}
            <button type="button" class="product-card__video-ctl" data-cv-stop aria-label="Stop video">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" fill="currentColor"></rect></svg>
            </button>
          </div>
        </div>
      </collection-card-video>
    {%- endif -%}
  </div>

  {%- comment -%} -------- Info -------- {%- endcomment -%}
  <div class="product-card__info product-item__info">

    {%- comment -%} Price markup — reused beside the title (desktop) and beside the CTA (mobile) {%- endcomment -%}
    {%- capture price_html -%}
      <div class="price-list">
        {%- if product.price_varies and product.compare_at_price -%}
          {%- assign cheapest_variant = product.variants | sort: 'price' | first -%}
          {%- capture price_min -%}{% if settings.currency_code_enabled %}{{ cheapest_variant.price | money_with_currency | remove: ".00" | remove: ",00" }}{% else %}{{ cheapest_variant.price | money | remove: ".00" | remove: ",00" }}{% endif %}{%- endcapture -%}
          {%- if cheapest_variant.price < cheapest_variant.compare_at_price -%}
            <span class="price price--highlight">{{- 'collection.product.from_price_html' | t: price_min: price_min -}}</span>
            <span class="price price--compare">{% if settings.currency_code_enabled %}{{ cheapest_variant.compare_at_price | money_with_currency | remove: ".00" | remove: ",00" }}{% else %}{{ cheapest_variant.compare_at_price | money | remove: ".00" | remove: ",00" }}{% endif %}</span>
          {%- else -%}
            <span class="price">{{- 'collection.product.from_price_html' | t: price_min: price_min -}}</span>
          {%- endif -%}
        {%- elsif product.price < product.compare_at_price -%}
          <span class="price price--highlight">{% if settings.currency_code_enabled %}{{ product.price | money_with_currency | remove: ".00" | remove: ",00" }}{% else %}{{ product.price | money | remove: ".00" | remove: ",00" }}{% endif %}</span>
          <span class="price price--compare">{% if settings.currency_code_enabled %}{{ product.compare_at_price | money_with_currency | remove: ".00" | remove: ",00" }}{% else %}{{ product.compare_at_price | money | remove: ".00" | remove: ",00" }}{% endif %}</span>
        {%- elsif product.price_varies -%}
          {%- capture price_min -%}{% if settings.currency_code_enabled %}{{ product.price_min | money_with_currency | remove: ".00" | remove: ",00" }}{% else %}{{ product.price_min | money | remove: ".00" | remove: ",00" }}{% endif %}{%- endcapture -%}
          {%- capture price_max -%}{% if settings.currency_code_enabled %}{{ product.price_max | money_with_currency | remove: ".00" | remove: ",00" }}{% else %}{{ product.price_max | money | remove: ".00" | remove: ",00" }}{% endif %}{%- endcapture -%}
          <span class="price">{{- 'collection.product.from_price_html' | t: price_min: price_min, price_max: price_max -}}</span>
        {%- else -%}
          <span class="price">{% if settings.currency_code_enabled %}{{ product.price | money_with_currency | remove: ".00" | remove: ",00" }}{% else %}{{ product.price | money | remove: ".00" | remove: ",00" }}{% endif %}</span>
        {%- endif -%}
      </div>
    {%- endcapture -%}

    {%- comment -%} Title (price sits beside it on desktop) {%- endcomment -%}
    <a href="{{ product.url }}" data-instant class="product-card__head product-item-meta__title">
      <span class="product-card__title title">{{ product.title | remove: 'Bro-To' | remove: 'Gro-To' }}</span>
      <span class="product-card__price product-card__price--head">{{ price_html }}</span>
    </a>

    {%- comment -%} Subtitle {%- endcomment -%}
    {%- if product.metafields.custom.product_subtitle__description != blank -%}
      <a href="{{ product.url }}" data-instant class="product-card__subtitle product-item-meta__subtitle text--xsmall">
        {{ product.metafields.custom.product_subtitle__description }}
      </a>
    {%- endif -%}

    {%- comment -%} Rating {%- endcomment -%}
    {%- if settings.show_product_rating -%}
      <a class="product-card__rating product-item-meta__reviews-badge text--small" href="{{ product.url }}" data-instant>
        {%- render 'product-rating', product: product -%}
      </a>
    {%- endif -%}

    {%- comment -%} Variant chips (display labels) {%- endcomment -%}
    {%- unless hide_variants or product.handle == "weekly-essentials" or product.handle contains "very-lightweight-moisturiser" or product.handle contains "matte-pop-blush" or product.handle == "ring-light" or product.handle == "glowy-blush" -%}
      {%- assign related_products = product.metafields.custom.product_main_information__related_products | split: "|" -%}
      {%- if product.variants.size > 1 or related_products != blank -%}
        <div class="product-card__variants variant-option">
          {%- if product.variants.size > 1 -%}
            {%- for variant in product.variants -%}
              <span class="option {% if product.media.first.alt contains variant.title %}active{% endif %} {% if product.handle == "transformazing" and forloop.first %}active{% endif %}">
                {%- if product.handle contains "very-" -%}{{ variant.title | remove: "Very" | capitalize }}{%- else -%}{{ variant.title | remove: " AUD" | capitalize }}{%- endif -%}
              </span>
            {%- endfor -%}
          {%- endif -%}
          {%- if related_products != blank -%}
            {%- for product_handle in related_products -%}
              {%- assign product_handle_handle = product_handle | handle -%}
              {%- assign related_product = all_products[product_handle_handle] -%}
              {%- assign related_product_title = related_product.metafields.gts_theme.alternate_title | default: related_product.title -%}
              <a href="{{ related_product.url }}" data-instant class="option {% if related_product.id == product.id %}active{% endif %}">
                {%- if product.handle contains "very-" -%}{{- related_product_title | upcase | remove: "VERY " | capitalize -}}{%- else -%}{{- related_product_title -}}{%- endif -%}
              </a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endunless -%}

    {%- comment -%} Colour swatches {%- endcomment -%}
    {%- if settings.product_color_display != 'hide' -%}
      {%- for color_label in color_label_list -%}
        {%- if product.options_by_name[color_label] != blank -%}
          {%- assign product_option = product.options_by_name[color_label] -%}
          {%- case settings.product_color_display -%}
            {%- when 'count' -%}
              <p class="product-card__color-count product-item-meta__color-count text--small text--subdued">{{- 'collection.product.available_colors_count' | t: count: product_option.values.size -}}</p>
            {%- when 'swatch' -%}
              <div class="product-card__swatches product-item-meta__swatch-list color-swatch-list color-swatch-list--mini">
                {%- assign variant_option = 'option' | append: product_option.position -%}
                {%- assign color_swatch_config = settings.color_swatch_config | newline_to_br | split: '<br />' -%}
                {%- capture color_name -%}{{ section.id }}-{{ block.id }}-{{ product.id }}{%- endcapture -%}
                {%- for value in product_option.values -%}
                  {%- capture color_id -%}{{ color_name }}-{{ forloop.index }}{%- endcapture -%}
                  {%- assign color_value_downcase = value | downcase -%}
                  {%- assign variant_for_value = product.variants | where: variant_option, value | first -%}
                  <div class="color-swatch {% if color_white_label == color_value_downcase %}color-swatch--white{% endif %}">
                    <input class="color-swatch__radio visually-hidden" type="radio" name="{{ color_name }}" id="{{ color_id }}" value="{{ value | escape }}" {% if product_option.selected_value == value %}checked="checked"{% endif %} data-variant-id="{{ variant_for_value.id }}" {% if variant_for_value.featured_media %}data-variant-featured-media="{{ variant_for_value.featured_media.id }}"{% endif %}>
                    <label class="color-swatch__item color-swatch-{{ product.handle }}-{{ value | handle }}" for="{{ color_id }}" style="{% render 'color-swatch-style', swatch: value.swatch, color_swatch_config: color_swatch_config, value: value %}">
                      <span class="visually-hidden">{{ value }}</span>
                    </label>
                  </div>
                {%- endfor -%}
              </div>
          {%- endcase -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} Price (mobile only) + CTA on one row {%- endcomment -%}
    {%- assign soldOutProduct = false -%}
    {%- for tag in product.tags -%}
      {%- if tag == "SOLDOUT" -%}{% assign soldOutProduct = true %}{% break %}{%- endif -%}
    {%- endfor -%}

    <div class="product-card__buy">
      <span class="product-card__price product-card__price--inline">{{ price_html }}</span>

    {%- if outerCollectionHandle == "build-your-routine" and section_name == "featured-collections" and enable_byo_bundle == true -%}
      {% render "product-item--ATC-BYO", product: product %}

    {%- elsif soldOutProduct == true -%}
      <button class="product-card__cta link link--primary back-in-stock">SOLD OUT</button>

    {%- elsif product.available -%}
      <div class="product-card__cta-wrapper product-item__cta-wrapper">
        {%- if product.variants.size == 1 -%}
          {%- capture form_id -%}product_form_{{ section.id }}_{{ block.id }}_{{ product.id }}_{% increment product_form_index %}{%- endcapture -%}
          {%- form 'product', product, is: 'product-form', id: form_id -%}
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
            {%- render 'add-tags-to-cart', product: product -%}
            <button type="submit" is="loader-button" class="product-card__cta product-item__link link--animated link link--primary"><span class="product-card__cta-full">{{ 'collection.product.add_to_cart_short' | t }}</span><span class="product-card__cta-short">{{ 'collection.product.add_to_cart_shorter' | t }}</span></button>
          {%- endform -%}
        {%- else -%}
          {%- capture QuickViewTitle -%}
            {% if product.options.size > 0 %}
              {% assign quick_view_variant_title = product.options.first %}
              <span class="product-card__cta-full">{{ 'collection.product.quick_view' | t: quick_view_title: quick_view_variant_title }}</span>
            {% else %}
              <span class="product-card__cta-full">{{ 'collection.product.quick_view' | t: quick_view_title: 'A Size' }}</span>
            {% endif %}
            <span class="product-card__cta-short">{{ 'collection.product.quick_view_short' | t }}</span>
          {%- endcapture -%}

          <button type="button" loader is="toggle-button" aria-controls="product-{{ section.id }}-{{ block.id }}-{{ product.id }}-drawer" aria-expanded="false" class="product-card__cta product-item__link link--animated link link--primary hidden-phone">{{ QuickViewTitle }}</button>
          <button type="button" loader is="toggle-button" aria-controls="product-{{ section.id }}-{{ block.id }}-{{ product.id }}-popover" aria-expanded="false" class="product-card__cta product-item__link link--animated link link--primary hidden-tablet-and-up">{{ QuickViewTitle }}</button>

          <quick-buy-popover id="product-{{ section.id }}-{{ block.id }}-{{ product.id }}-popover" href="{{ product.url }}" class="popover popover--quick-buy hidden-tablet-and-up"></quick-buy-popover>
          <quick-buy-drawer id="product-{{ section.id }}-{{ block.id }}-{{ product.id }}-drawer" href="{{ product.url }}" class="drawer drawer--large drawer--quick-buy hidden-phone"></quick-buy-drawer>
        {%- endif -%}
      </div>

    {%- else -%}
      {%- assign noWaitlist = false -%}
      {%- if product.tags contains 'no-waitlist' -%}{% assign noWaitlist = true %}{%- endif -%}
      <div class="product-card__cta-wrapper product-item__cta-wrapper">
        {%- unless noWaitlist -%}
          <button onclick="openBackInStock({{ product.id }},{{ product.selected_or_first_available_variant.id }},'{{ product.title | remove: 'Bro-To' | remove: 'Gro-To' }}')" class="product-card__cta link link--primary back-in-stock"><span class="product-card__cta-full">WAITLIST ME</span><span class="product-card__cta-short">WAITLIST</span></button>
        {%- endunless -%}
      </div>
    {%- endif -%}
    </div>
  </div>
</product-item>
{%- endunless -%}
