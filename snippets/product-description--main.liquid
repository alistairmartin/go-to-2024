        {%- comment %} CONTENT -  DESCRIPTION {% endcomment -%}
        
<div class="product-content-description--content-inner tab-panel description" id="product-content-description--tab-1" role="tabpanel" tabindex="0" aria-labelledby="product-content-description--tab-1" aria-hidden="{{ hidden }}">

        <div class="column">
            
          <div class="text-column">
            {%- assign title_html = product.metafields.custom["whats_this_all_about__title-html"] -%}
            <div class="h2 heading title">
              {%- if title_html != blank -%}
                {{ title_html.value }}
              {%- else -%}
                {{ product.metafields.custom.whats_this_all_about__title | metafield_text }}
              {%- endif -%}
            </div>

            <div class="description">
               {{ product.metafields.custom.whats_this_all_about__description2.value }}
            </div>

          
          {%- assign plays_nice_badges = product.metafields.custom.badges_plays_nice_with.value -%}
          {%- assign good_to_know_badges = product.metafields.custom.badges_good_to_know.value -%}
          {%- assign plays_nice_heading = 'product.content.plays_nice_with' | t -%}
          {%- assign good_to_know_heading = 'product.content.good_to_know' | t -%}

          {% render "product-content-badges", badges: plays_nice_badges, heading: plays_nice_heading, class_root: 'perfect-for' %}

          {% render "product-content-badges", badges: good_to_know_badges, heading: good_to_know_heading, class_root: 'who-is-it-for' %}

        </div>

        <div class="image-column">
            {% render "responsive-image-metafields", src_desktop: product.metafields.custom.whats_this_all_about__image_desktop, src_mobile: product.metafields.custom.whats_this_all_about__image_desktop %}
        </div>
    </div>
</div>
