{% comment %} <button class="blocks--button {{ classes }} {% if block.settings.button_style contains "link" %}link--{% if section.settings.button_style == 'link-with-arrow-white' %}secondary{% else %}primary{% endif %}{% else %}button {{ block.settings.button_style }}{% endif %}" {{ blockId }}>{{ block.settings.button_text }} {% if block.settings.button_style == "link-with-arrow" %}{%- render 'icon' with "brand-arrow-right" -%}{% endif %}</button>
{%- render 'modal', modalId: modalId, content: block.settings.modal_content, buttonId: buttonId -%} {% endcomment %}

<script>
    document.addEventListener("DOMContentLoaded", function() {
      var modal = document.getElementById('{{ modalId }}-modal');
      if (!modal) {
        return;
      }

      {% if teleport %}
      // Escape transformed/clipping ancestors (e.g. slideshow slides) so the
      // fixed-position modal can layer above the page.
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
      {% endif %}

      ['{{ buttonId }}'{% if buttonIdMobile != blank %}, '{{ buttonIdMobile }}'{% endif %}].forEach(function(id) {
        var button = document.getElementById(id);
        if (!button) {
          return;
        }

        button.addEventListener('click', function(event) {
          event.preventDefault();
          modal.open = true;
        });
      });
    });

    (function() {
      if (window.__modalCustomFadeInit) {
        return;
      }
      window.__modalCustomFadeInit = true;

      document.addEventListener('openable-element:open', function(event) {
        var target = event.target;
        if (!target || !target.classList || !target.classList.contains('modal-custom')) {
          return;
        }

        var overlay = target.querySelector('.modal__overlay');
        var content = target.querySelector('.modal__content');

        if (overlay && overlay.animate) {
          var isMobile = window.matchMedia('(max-width: 740px)').matches;
          overlay.animate([{ opacity: 0 }, { opacity: 0.3 }], {
            duration: 350,
            easing: 'ease',
            fill: 'forwards',
            delay: isMobile ? 450 : 0
          });
        }

        if (content && content.animate) {
          content.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: 350,
            easing: 'ease',
            fill: 'forwards'
          });
        }

        var inner = target.querySelector('.modal__content-inner');
        if (inner && inner.animate && window.matchMedia('(max-width: 740px)').matches) {
          inner.animate([{ transform: 'translateY(100%)' }, { transform: 'translateY(0)' }], {
            duration: 450,
            easing: 'cubic-bezier(.22, .61, .36, 1)',
            fill: 'forwards'
          });
        }
      });
    })();
  </script>

<modal-content section="{{ modalId }}" id="{{ modalId }}-modal" class="modal modal-custom" {% if content_square_id != blank %}data-content-square="{{ content_square_id }}"{% endif %}>
  <div class="modal__overlay"></div>

  <div class="modal__content">
    <button type="button" class="modal__close-button tap-area" data-action="close" title="{{ 'general.accessibility.close' | t | escape }}">
      {%- render 'icon' with 'close' -%}
    </button>

    <div class="modal__content-inner {{ class }}">
        {{ content }}
    </div>
  </div>
</modal-content>
