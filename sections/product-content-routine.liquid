                <path d="M39.6784 57.8882C32.2087 59.9157 24.6853 61.3506 17.1256 62.3202C15.2821 62.5444 13.354 62.7635 11.527 62.9045C10.8334 62.9463 9.98805 63.1052 9.29334 62.9365C8.80199 62.8223 8.83498 62.6559 9.01861 62.162C9.25173 61.4186 9.60357 60.7244 9.9554 60.0303C10.3402 59.1699 10.8097 58.3146 11.2792 57.4593C12.117 55.8267 13.0735 54.2435 14.1146 52.6654C16.4322 49.1869 19.1059 45.8563 22.0181 42.835C22.6074 42.2396 22.4327 41.1766 21.8216 40.8026C21.1423 40.3402 20.2805 40.5822 19.6747 41.2608C16.8131 44.2431 14.2064 47.4514 11.9394 50.891C10.7806 52.6302 9.65586 54.4137 8.70043 56.2074C7.81206 57.879 6.82256 59.6286 6.22219 61.3599C5.53825 63.2965 5.98768 65.134 7.92011 65.7571C9.69975 66.2867 11.9313 65.8336 13.8088 65.6536C17.919 65.231 22.0621 64.6421 26.1536 63.8816C30.7354 63.0248 35.2996 62.0407 39.8287 60.8018C40.6399 60.5988 41.2963 59.8812 41.2414 59.0781C41.2711 58.2801 40.4556 57.641 39.6784 57.8882Z" fill="#181818"/>
              </svg>
              <p>{{ section.settings.button_label }}</p>
            </div>

            <button class="product-content-routine--text__switcher">
              <div class="product-content-routine--text__switcher-circle"></div>

            </button>
          </div>
        {% endif %}

        <div class="product-content-routine--text__morning">
          <h3 class="SectionHeader__Heading heading h3">
            {%- if product.metafields.custom.product_routine__title_morning != blank -%}
              {{ product.metafields.custom.product_routine__title_morning }}
            {%- else -%}
              {{ section.settings.title_morning }}
            {%- endif -%}
          </h3>

          <div class="product-content-routine--text__morning-text">
            {{ product.metafields.custom.product_routine__steps-morning }}
          </div>
        </div>

        <div class="product-content-routine--text__evening">
          <h3 class="SectionHeader__Heading heading h3">
            {%- if product.metafields.custom.product_routine__title_evening != blank -%}
              {{ product.metafields.custom.product_routine__title_evening }}
            {%- else -%}
              {{ section.settings.title_evening }}
            {%- endif -%}
          </h3>
          <div class="product-content-routine--text__evening-text">
            {{ product.metafields.custom.product_routine__steps-evening }}
          </div>
        </div>

      </div>

      <div class="product-content-routine--image">
        <div class="product-content-routine--image__morning">
          {%- if product.metafields.custom.product_routine__image_desktop_morning != blank or product.metafields.custom.product_routine__image_mobile_morning != blank -%}
            {% render "responsive-image-metafields", src_desktop: product.metafields.custom.product_routine__image_desktop_morning, src_mobile: product.metafields.custom.product_routine__image_mobile_morning %}
          {%- endif -%}
        </div>
        <div class="product-content-routine--image__evening">
          {%- if product.metafields.custom.product_routine__image_desktop_evening != blank or product.metafields.custom.product_routine__image_mobile_evening != blank -%}
            {% render "responsive-image-metafields", src_desktop: product.metafields.custom.product_routine__image_desktop_evening, src_mobile: product.metafields.custom.product_routine__image_mobile_evening %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
  {
    "name": "Prod. Con: Routine",
    "settings": [
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Swipe Me"
      },
      {
        "type": "header",
        "content": "Titles"
      },
      {
        "type": "text",
        "id": "title_morning",
        "label": "morning"
      },
      {
        "type": "text",
        "id": "title_evening",
        "label": "evening"
      }
    ],
    "presets":[
      {
        "name": "Prod. Con: Routine",
        "category": "Product"
      }
    ]
  }
{% endschema %}
