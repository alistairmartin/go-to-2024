

<section>
  <div class="container">
    <div class="product-content-description-V2 product-content-description">


        
        <div class="tab-list">
          <div class="tab-list--outer  {% if hideTabs == true %}hide{% endif %}">
            <div class="tab-list--inner" role="tablist">
              <button data-action="toggle-tab" role="tab" aria-selected="true" aria-controls="product-content-description--tab-1" class="tab-list--tab active">{{ 'product.content.what_is_it' | t }}</button>

              {% comment %} {%- if product.metafields.custom.product_main_information__review_title != blank -%}
                <button data-action="toggle-tab" role="tab" aria-selected="false" aria-controls="product-content-description--tab-2" class="tab-list--tab">{{ 'product.content.reviews' | t }}</button>
              {%- endif -%}

              {%- if product.metafields.accentuate.product_main_information__whats_in_it != blank -%}
                <button data-action="toggle-tab" role="tab" aria-selected="false" aria-controls="product-content-description--tab-3" class="tab-list--tab">{{ 'product.content.whats_in_it' | t }}</button>
              {%- endif -%}

              {%- if product.metafields.custom.product_main_information__included_products != blank -%}
                <button data-action="toggle-tab" role="tab" aria-selected="false" aria-controls="product-content-description--tab-4" class="tab-list--tab">{{ 'product.content.whats_included' | t }}</button>
              {%- endif -%} {% endcomment %}

            
              <button data-action="toggle-tab" role="tab" aria-selected="true" aria-controls="product-content-description--tab-2" class="tab-list--tab">
                  CLINICAL TRIALS
              </button>

               <button data-action="toggle-tab" role="tab" aria-selected="true" aria-controls="product-content-description--tab-3" class="tab-list--tab">
                  AM / PM
              </button>

              <button data-action="toggle-tab" role="tab" aria-selected="true" aria-controls="product-content-description--tab-4" class="tab-list--tab">
                  WHAT'S IN IT?
              </button>

              <button data-action="toggle-tab" role="tab" aria-selected="true" aria-controls="product-content-description--tab-5" class="tab-list--tab">
                  REUSE & RECYCLE
              </button>


            </div>
          </div>


          {%- render 'product-description--main' product: product, tab: 1  -%}

          {%- render 'product-description--clinical-trial' product: product, tab: 2  -%}

          {%- render 'product-description--routine' product: product, tab: 3 -%}

          {%- render 'product-description--ingredients' product: product, tab: 4 -%}

          {%- render 'product-description--recycle' product: product, tab: 5 -%}


          </div>

      
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Prod. Con: Description V2",
  "class": "shopify-section--product-content-description",
  "settings": [],
  "presets":[
    {
      "name": "Prod. Con: Description V2",
      "category": "Product"
    }
  ]
}
{% endschema %}
