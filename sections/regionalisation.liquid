{%- comment -%}
  Regionalisation popup (ported from Honey Birdette "Regionalisation V2").

  Go-To is ONE Shopify store with several market domains (gotoskincare.com,
  eu./uk./us.gotoskincare.com). This section never navigates on its own: when
  the visitor's detected country belongs to a different store than the one
  they are on, it shows a dismissible "We see you're in X" prompt and lets
  THEM choose. Switching goes through Shopify's own localization form, so
  Shopify picks the correct domain, country and currency. Crawlers (Googlebot
  crawls from US IPs) are never prompted, which keeps every regional domain
  independently indexable.

  Country -> market mapping comes straight from Shopify Markets via Liquid
  (country.market.handle); blocks map market handles -> a "store" for display.
{%- endcomment -%}

{%- liquid
  assign enabled = section.settings.enable_regionalisation
  assign current_market = localization.market.handle | downcase
  assign current_country = localization.country.iso_code | upcase
-%}

{%- if enabled -%}
  {{ 'regionalisation.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'regionalisation.min.js' | asset_url }}" defer></script>

  <geolocation-region>
    <div
      class="geo-popup"
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby="geo-popup-heading"
      data-tpl-heading="{{ section.settings.heading | escape }}"
      data-tpl-subtext="{{ section.settings.subtext | escape }}"
      data-tpl-cta="{{ section.settings.cta_text | escape }}"
    >
      <div class="geo-popup__overlay" data-geo-close></div>

      <div class="geo-popup__card">
        <button type="button" class="geo-popup__close tap-area" data-geo-close aria-label="{{ 'general.accessibility.close' | t | escape }}">
          {%- render 'icon' with 'close' -%}
        </button>

        <div class="geo-popup__flags">
          <span class="geo-popup__flag" data-geo-from-flag></span>
          <span class="geo-popup__arrow" data-geo-arrow aria-hidden="true">
            <svg width="18" height="14" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/></svg>
          </span>
          <span class="geo-popup__flag" data-geo-to-flag></span>
        </div>

        {%- if section.settings.eyebrow != blank -%}
          <p class="geo-popup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="geo-popup-heading" class="geo-popup__heading heading h5" data-geo-heading></h2>
        <p class="geo-popup__subtext" data-geo-subtext></p>

        {%- form 'localization', id: 'geo-popup-localization-form', class: 'geo-popup__form' -%}
          {%- comment -%} Shopify's localization form already emits its own return_to input; JS updates it before submit. {%- endcomment -%}
          <input type="hidden" name="country_code" value="{{ current_country }}" data-geo-country-input>
          <button type="submit" class="button button--primary button--full geo-popup__cta" data-geo-shop>
            <span data-geo-cta-text>{{ section.settings.cta_text | escape }}</span>
            <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/></svg>
          </button>
        {%- endform -%}

        <button type="button" class="geo-popup__stay" data-geo-stay>{{ section.settings.stay_text | escape }}</button>
      </div>

      {%- comment -%} Flag bank: destination flags cloned into the popup by store key. {%- endcomment -%}
      <template data-geo-flag-bank>
        {%- for block in section.blocks -%}
          {%- if block.settings.flag_select != 'none' and block.settings.flag_select != blank -%}
            <span data-flag-store="{{ block.id }}">
              {%- case block.settings.flag_select -%}
                {%- when 'icon-flag-australia' -%}{%- render 'icon-flag-australia' -%}
                {%- when 'icon-flag-new-zealand' -%}{%- render 'icon-flag-new-zealand' -%}
                {%- when 'icon-flag-united-kingdom' -%}{%- render 'icon-flag-united-kingdom' -%}
                {%- when 'icon-flag-united-states' -%}{%- render 'icon-flag-united-states' -%}
                {%- when 'icon-flag-canada' -%}{%- render 'icon-flag-canada' -%}
                {%- when 'icon-flag-europe' -%}{%- render 'icon-flag-europe' -%}
                {%- when 'icon-flag-france' -%}{%- render 'icon-flag-france' -%}
                {%- when 'icon-flag-germany' -%}{%- render 'icon-flag-germany' -%}
              {%- endcase -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </template>
    </div>
  </geolocation-region>

  <script type="application/json" data-geo-settings>
    {
      "current_market": {{ current_market | json }},
      "current_country": {{ current_country | json }},
      "auto_redirect": {{ section.settings.auto_redirect | json }},
      "cookie_domain": {{ section.settings.cookie_domain | json }},
      "primary_hosts": {{ section.settings.primary_hosts | json }},
      "debug": {{ section.settings.debug | json }},
      "stores": [
        {%- for block in section.blocks -%}
          {
            "id": {{ block.id | json }},
            "title": {{ block.settings.title | json }},
            "markets": {{ block.settings.markets | downcase | remove: ' ' | json }},
            "flag_iso": {% case block.settings.flag_select %}{% when 'icon-flag-australia' %}"AU"{% when 'icon-flag-new-zealand' %}"NZ"{% when 'icon-flag-united-kingdom' %}"GB"{% when 'icon-flag-united-states' %}"US"{% when 'icon-flag-canada' %}"CA"{% when 'icon-flag-france' %}"FR"{% when 'icon-flag-germany' %}"DE"{% else %}""{% endcase %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "countries": {
        {%- for country in localization.available_countries -%}
          {{ country.iso_code | upcase | json }}: { "m": {{ country.market.handle | downcase | json }}, "n": {{ country.name | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Regionalisation popup",
  "class": "shopify-section--regionalisation",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_regionalisation",
      "label": "Enable regionalisation popup",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_redirect",
      "label": "Auto-redirect (skip popup)",
      "info": "When enabled, visitors are switched to their regional store automatically instead of seeing the prompt. SEO note: this is the higher cloaking-risk option - keep it off to stay Google-compliant. Search crawlers are never redirected regardless.",
      "default": false
    },
    {
      "type": "text",
      "id": "primary_hosts",
      "label": "Primary store hosts",
      "info": "Comma separated. A returning visitor who previously confirmed another store is sent there automatically ONLY from these hosts. Regional domains are never auto-redirected.",
      "default": "gotoskincare.com,www.gotoskincare.com"
    },
    {
      "type": "text",
      "id": "cookie_domain",
      "label": "Cookie domain",
      "info": "Shared across all subdomains so choices carry between stores.",
      "default": "gotoskincare.com"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Before you shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "{country} is replaced with the detected country.",
      "default": "We see you're in {country}"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "info": "{store} is replaced with the suggested store name.",
      "default": "The best shopping experience for you is on the {store} store."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop now on {store}"
    },
    {
      "type": "text",
      "id": "stay_text",
      "label": "Stay link text",
      "default": "Stay on current store"
    },
    {
      "type": "checkbox",
      "id": "debug",
      "label": "Console debug logging",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Store name",
          "info": "Shown in the popup, e.g. \"United States\"."
        },
        {
          "type": "text",
          "id": "markets",
          "label": "Market handles",
          "info": "Comma separated Shopify Market handles served by this store, e.g. \"au,nz,international\". Find handles under Settings > Markets."
        },
        {
          "type": "select",
          "id": "flag_select",
          "label": "Flag",
          "options": [
            { "label": "Australia", "value": "icon-flag-australia" },
            { "label": "New Zealand", "value": "icon-flag-new-zealand" },
            { "label": "United Kingdom", "value": "icon-flag-united-kingdom" },
            { "label": "United States", "value": "icon-flag-united-states" },
            { "label": "Canada", "value": "icon-flag-canada" },
            { "label": "Europe", "value": "icon-flag-europe" },
            { "label": "France", "value": "icon-flag-france" },
            { "label": "Germany", "value": "icon-flag-germany" },
            { "label": "None", "value": "none" }
          ],
          "default": "icon-flag-australia"
        }
      ]
    }
  ],
  "default": {
    "settings": { "enable_regionalisation": true, "auto_redirect": false },
    "blocks": [
      { "type": "store", "settings": { "title": "Australia & New Zealand", "markets": "au,nz,international", "flag_select": "icon-flag-australia" } },
      { "type": "store", "settings": { "title": "Europe", "markets": "eu", "flag_select": "icon-flag-europe" } },
      { "type": "store", "settings": { "title": "United Kingdom", "markets": "gb", "flag_select": "icon-flag-united-kingdom" } },
      { "type": "store", "settings": { "title": "United States", "markets": "us", "flag_select": "icon-flag-united-states" } }
    ]
  }
}
{% endschema %}
